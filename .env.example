# Copy to .env and replace every required placeholder. Never commit .env.
POSTGRES_DB=workplanstudio
POSTGRES_USER=workplanstudio
POSTGRES_PASSWORD=replace-with-a-long-random-password
ALLOWED_HOSTS=workplan.example.com
HTTP_PORT=8080

# One-time bootstrap only; remove both values after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional server-side narrator. The key is never sent to the browser.
ASSISTANT_API_KEY=
ASSISTANT_ENDPOINT=https://api.openai.com/v1/
ASSISTANT_MODEL=gpt-4.1-mini
OTEL_EXPORTER_OTLP_ENDPOINT=
