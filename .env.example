# Copy to .env and replace every required placeholder. Never commit .env.
POSTGRES_DB=workplanstudio
POSTGRES_USER=workplanstudio
POSTGRES_PASSWORD=replace-with-a-long-random-password
ALLOWED_HOSTS=workplan.example.com
HTTP_PORT=8080

# One-time bootstrap only; remove both values after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Password-reset delivery. Use a verified sender and secret-manager supplied credentials.
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-secret
SMTP_SENDER_ADDRESS=no-reply@workplan.example.com
SMTP_SENDER_NAME=WorkPlan Studio
PUBLIC_BASE_URL=https://workplan.example.com

# Optional server-side narrator. The key is never sent to the browser.
ASSISTANT_API_KEY=
ASSISTANT_ENDPOINT=https://api.openai.com/v1/
ASSISTANT_MODEL=gpt-4.1-mini
OTEL_EXPORTER_OTLP_ENDPOINT=
