# Normalise line endings on commit; let git detect what is text.
* text=auto eol=lf

# Scripts keep their platform-native endings
*.sh   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets — no eol normalisation, no text diffing
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff  binary
*.woff2 binary

# GitHub linguist — keep the language stats focused on the app's own code,
# not the docs. There is no vendored JavaScript to exclude: wwwroot holds five
# hand-written files and nothing else.
docs/** linguist-documentation
*.md    linguist-documentation
