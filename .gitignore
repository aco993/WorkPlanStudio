# The .NET build output folder, at the repository root only. Not a blanket
# "artifacts" rule: the E2E run writes its evidence — screenshots, visual
# diffs — under artifacts/e2e, and a screenshot the docs refer to should be
# visible to git status rather than silently invisible.
/artifacts/*
!/artifacts/e2e/
*.nupkg
*.snupkg
.packages/

# Blazor WebAssembly publish output
publish/
wwwroot/_framework/

# SQLite local databases (the app stores its DB in the browser, not on disk)
*.db
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db
desktop.ini
