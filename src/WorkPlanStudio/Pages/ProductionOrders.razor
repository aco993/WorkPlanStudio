@page "/production-orders"
@using System.Globalization
@using WorkPlanStudio.Validation
@inject IStringLocalizer<SharedResource> L
@inject ProductionOrderService Orders
@inject WorkPlanService Plans
@inject UiAnnouncer Announcer

@using WorkPlanStudio.Services.Forms

<PageTitle>@L["Orders_Title"] · WorkPlan Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Orders_Title"]</h1>
        <p class="page-sub">@L["Orders_Subtitle"]</p>
    </div>
    <AuthorizeView Policy="@Permissions.ManageOrders">
        <button class="btn btn-primary" @onclick="New">
            <span class="btn-plus">+</span> @L["Orders_New"]
        </button>
    </AuthorizeView>
</div>

<ReadOnlyNotice Policy="@Permissions.ManageOrders" />

@if (_error is not null)
{
    <div class="form-banner error" role="alert">@_error</div>
}

@if (_loading)
{
    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
}
else if (_orders.Count == 0)
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 9h6M9 13h6M9 17h3" /></svg>
        <p>@L["Orders_Empty"]</p>
    </div>
}
else
{
    @*
        Orders are the transactional entity — one row per order per week — so this
        is the list that actually grows. Work plans got a search box and a status
        filter; the list that needs them most had neither.
    *@
    <div class="toolbar">
        <div class="search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" aria-label="@L["Md_Orders_SearchPlaceholder"]"
                   placeholder="@L["Md_Orders_SearchPlaceholder"]"
                   value="@_search" @oninput="OnSearch" />
        </div>
        <div class="seg">
            <button class="@(_statusFilter is null ? "active" : null)" @onclick="() => _statusFilter = null">@L["Common_All"]</button>
            @foreach (var status in _statuses)
            {
                <button class="@(_statusFilter == status ? "active" : null)" @onclick="() => _statusFilter = status">@StatusLabel(status)</button>
            }
        </div>
    </div>

    @if (!Filtered.Any())
    {
        <NoMatches />
    }
    else
    {
        <div class="card no-pad">
            <table class="data-table hover">
                <caption class="sr-only">@L["Orders_Title"]</caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@SortState(OrderColumn.Number)">
                            <button type="button" class="th-sort" @onclick="() => SortBy(OrderColumn.Number)">@L["Orders_Number"]@SortMark(OrderColumn.Number)</button>
                        </th>
                        <th scope="col">@L["Field_PartName"]</th>
                        <th scope="col">@L["Orders_Routing"]</th>
                        <th scope="col" class="num">@L["Orders_Quantity"]</th>
                        <th scope="col" class="num">@L["Orders_Release"]</th>
                        <th scope="col" class="num" aria-sort="@SortState(OrderColumn.Due)">
                            <button type="button" class="th-sort" @onclick="() => SortBy(OrderColumn.Due)">@L["Orders_Due"]@SortMark(OrderColumn.Due)</button>
                        </th>
                        <th scope="col" class="center" aria-sort="@SortState(OrderColumn.Priority)">
                            <button type="button" class="th-sort" @onclick="() => SortBy(OrderColumn.Priority)">@L["Field_Priority"]@SortMark(OrderColumn.Priority)</button>
                        </th>
                        <th scope="col">@L["Field_Status"]</th>
                        <th scope="col" class="actions-col">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in _page.Slice(Filtered.ToList()))
                    {
                        <tr @key="order.Id">
                            <td><span class="mono">@order.OrderNumber</span></td>
                            <td>@(order.WorkPlan?.PartName ?? "—")</td>
                            <td>
                                <span class="mono muted">@(order.WorkPlan?.PlanNumber ?? "—")</span>
                                @if (order.Status != ProductionOrderStatus.Draft)
                                {
                                    <span class="pill frozen" title="@L["Orders_SnapshotTooltip"]">@L["Orders_Frozen"]</span>
                                }
                            </td>
                            <td class="num">@Format.Number(order.Quantity)</td>
                            <td class="num muted">@order.ReleaseLocal.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td class="num">@order.DueLocal.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td class="center">@PriorityLabel(order.Priority)</td>
                            <td><span class="badge order-@order.Status.ToString().ToLowerInvariant()">@StatusLabel(order.Status)</span></td>
                            <td class="actions-col">
                                <AuthorizeView Policy="@Permissions.ManageOrders">
                                    @if (order.Status == ProductionOrderStatus.Draft)
                                    {
                                        <button class="btn btn-outline" @onclick="() => ReleaseAsync(order)">@L["Orders_Release"]</button>
                                        <button class="icon-btn danger" aria-label="@L["Common_Delete"]" title="@L["Common_Delete"]" @onclick="() => AskDelete(order)">
                                            <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                        </button>
                                    }
                                    else if (order.Status == ProductionOrderStatus.Released)
                                    {
                                        <button class="btn btn-ghost" @onclick="() => AskCancel(order)">@L["Orders_Cancel"]</button>
                                    }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Paginator Window="_page" OnChanged="StateHasChanged" />
    }

    <p class="page-sub" style="margin-top:1rem">@L["Orders_ImmutabilityNote"]</p>
}

@*
    Both of these are one-way doors — a deleted draft is gone, and a withdrawn
    order drops the routing index that made it schedulable and cannot be
    released again — so both ask, exactly as the three master-data pages do.
*@
<Modal @bind-Visible="_showDelete" Title="@L["Confirm_DeleteOrderTitle"]">
    <ChildContent>
        <p>@(string.Format(L["Confirm_DeleteOrderBody"], _pending?.OrderNumber))</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showDelete = false">@L["Common_Cancel"]</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">@L["Common_Delete"]</button>
    </Footer>
</Modal>

<Modal @bind-Visible="_showCancel" Title="@L["Confirm_CancelOrderTitle"]">
    <ChildContent>
        <p>@(string.Format(L["Confirm_CancelOrderBody"], _pending?.OrderNumber))</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showCancel = false">@L["Orders_KeepOrder"]</button>
        <button class="btn btn-danger" @onclick="ConfirmCancelAsync">@L["Orders_Cancel"]</button>
    </Footer>
</Modal>

<Modal @bind-Visible="_showEditor" Title="@L["Orders_NewTitle"]">
    <ChildContent>
        <MdErrorSummary State="_errors" />
        <div class="form-grid">
            <label class="field">
                <span>@L["Orders_Number"]</span>
                <input id="po-number" class="input @_errors.Style("OrderNumber")" maxlength="30"
                       autocomplete="off" spellcheck="false" autocapitalize="characters"
                       aria-invalid="@_errors.Invalid("OrderNumber")" aria-describedby="@_errors.DescribedBy("OrderNumber")"
                       @bind="_editing.OrderNumber" @bind:event="oninput" />
                @if (_errors["OrderNumber"] is { } numberError)
                {
                    <span id="@_errors.ErrorId("OrderNumber")" class="field-error">@numberError</span>
                }
            </label>

            <div class="field">
                <label for="po-plan">@L["Orders_Routing"]</label>
                <EntityPicker TItem="WorkPlan" Id="po-plan"
                              Items="_plans"
                              Value="@(_editing.WorkPlanId == 0 ? null : _editing.WorkPlanId)"
                              ValueChanged="value => _editing.WorkPlanId = value ?? 0"
                              IdOf="p => p.Id"
                              LabelOf="PlanLabel"
                              EmptyHint="@L["Md_Orders_NoReleasedPlans"]"
                              Invalid="_errors.Has(PlanField)"
                              DescribedBy="@_errors.DescribedBy("WorkPlanId")" />
                @if (_errors["WorkPlanId"] is { } planError)
                {
                    <span id="@_errors.ErrorId("WorkPlanId")" class="field-error">@planError</span>
                }
            </div>

            <label class="field">
                <span>@L["Orders_Quantity"]</span>
                <input id="po-qty" class="input num @_errors.Style("Quantity")"
                       type="number" min="1" max="1000000" inputmode="numeric"
                       aria-invalid="@_errors.Invalid("Quantity")" aria-describedby="@_errors.DescribedBy("Quantity")"
                       @bind="_quantity" @bind:event="oninput" />
                @if (_errors["Quantity"] is { } quantityError)
                {
                    <span id="@_errors.ErrorId("Quantity")" class="field-error">@quantityError</span>
                }
            </label>

            <label class="field">
                <span>@L["Field_Priority"]</span>
                @*
                    Five naked digits told the planner nothing: the model documents
                    "1 (normal) to 5 (rush)" and the UI showed neither end of the
                    scale. Named options say which way is urgent.
                *@
                <select id="po-priority" class="input @_errors.Style("Priority")"
                        aria-invalid="@_errors.Invalid("Priority")" aria-describedby="@_errors.DescribedBy("Priority")"
                        @bind="_editing.Priority">
                    @for (int p = ProductionOrderValidator.MinPriority; p <= ProductionOrderValidator.MaxPriority; p++)
                    {
                        <option value="@p">@PriorityLabel(p)</option>
                    }
                </select>
                @if (_errors["Priority"] is { } priorityError)
                {
                    <span id="@_errors.ErrorId("Priority")" class="field-error">@priorityError</span>
                }
            </label>

            <label class="field">
                <span>@L["Orders_Release"]</span>
                <input id="po-release" class="input @_errors.Style("ReleaseLocal")" type="date"
                       max="@_dueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                       aria-invalid="@_errors.Invalid("ReleaseLocal")" aria-describedby="@_errors.DescribedBy("ReleaseLocal")"
                       @bind="_releaseDate" />
                @if (_errors["ReleaseLocal"] is { } releaseError)
                {
                    <span id="@_errors.ErrorId("ReleaseLocal")" class="field-error">@releaseError</span>
                }
            </label>

            <label class="field">
                <span>@L["Orders_Due"]</span>
                <input id="po-due" class="input @_errors.Style("DueLocal")" type="date"
                       min="@_releaseDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                       aria-invalid="@_errors.Invalid("DueLocal")" aria-describedby="@_errors.DescribedBy("DueLocal")"
                       @bind="_dueDate" />
                @if (_errors["DueLocal"] is { } dueError)
                {
                    <span id="@_errors.ErrorId("DueLocal")" class="field-error">@dueError</span>
                }
            </label>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showEditor = false">@L["Common_Cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveAsync">@L["Common_Save"]</button>
    </Footer>
</Modal>

@code {
    // Every row here carries controls, so the table draws one page of them
    // rather than all of them. See PageWindow for what the measurement was.
    private readonly PageWindow _page = new();
    private enum OrderColumn { Number, Due, Priority }

    private const string PlanField = nameof(ProductionOrder.WorkPlanId);

    // The project's stylesheet belongs to another stream, so the sortable header
    // carries its own reset rather than inventing a class nothing defines. It
    // keeps the focus ring, which is the part that matters.
    private bool _loading = true;
    private string? _error;
    private List<ProductionOrder> _orders = [];
    private List<WorkPlan> _plans = [];
    private string _search = "";
    private ProductionOrderStatus? _statusFilter;
    private OrderColumn _sortColumn = OrderColumn.Due;
    private bool _sortDescending = true;

    private readonly ProductionOrderStatus[] _statuses =
    [
        ProductionOrderStatus.Draft, ProductionOrderStatus.Released, ProductionOrderStatus.Cancelled
    ];

    private bool _showEditor;
    private bool _showDelete;
    private bool _showCancel;
    private ProductionOrder? _pending;
    private ProductionOrder _editing = new();
    private int? _quantity;

    // Plant-local wall-clock dates, like everything else the shop calendar reads.
    private DateTime _releaseDate = DateTime.Today;
    private DateTime _dueDate = DateTime.Today.AddDays(7);
    private readonly FormErrorState _errors = new();

    protected override void OnInitialized()
    {
        _errors.Declare("OrderNumber", "po-number", L["Orders_Number"]);
        _errors.Declare("WorkPlanId", "po-plan", L["Orders_Routing"]);
        _errors.Declare("Quantity", "po-qty", L["Orders_Quantity"]);
        _errors.Declare("Priority", "po-priority", L["Field_Priority"]);
        _errors.Declare("ReleaseLocal", "po-release", L["Orders_Release"]);
        _errors.Declare("DueLocal", "po-due", L["Orders_Due"]);
        _errors.Declare("Status", "po-number", L["Field_Status"]);
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _orders = await Orders.GetAllAsync();
            _plans = (await Plans.GetAllAsync())
                .Where(p => p.Status == WorkPlanStatus.Released)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private void SortBy(OrderColumn column)
    {
        if (_sortColumn == column)
            _sortDescending = !_sortDescending;
        else
            (_sortColumn, _sortDescending) = (column, false);
    }

    private string SortState(OrderColumn column) =>
        _sortColumn != column ? "none" : _sortDescending ? "descending" : "ascending";

    private string SortMark(OrderColumn column) =>
        _sortColumn != column ? "" : _sortDescending ? " ↓" : " ↑";

    private IEnumerable<ProductionOrder> Filtered
    {
        get
        {
            var filtered = _orders
                .Where(o => _statusFilter is null || o.Status == _statusFilter)
                .Where(o => string.IsNullOrWhiteSpace(_search)
                    || o.OrderNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (o.WorkPlan?.PartName.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (o.WorkPlan?.PlanNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            return _sortColumn switch
            {
                OrderColumn.Number => Order(filtered, o => o.OrderNumber),
                OrderColumn.Priority => Order(filtered, o => o.Priority),
                _ => Order(filtered, o => o.DueLocal)
            };
        }
    }

    private IEnumerable<ProductionOrder> Order<TKey>(IEnumerable<ProductionOrder> source, Func<ProductionOrder, TKey> key) =>
        _sortDescending ? source.OrderByDescending(key) : source.OrderBy(key);

    private async Task New()
    {
        _errors.Clear();
        _error = null;
        _releaseDate = DateTime.Today;
        _dueDate = DateTime.Today.AddDays(7);
        _quantity = 100;
        _editing = new ProductionOrder
        {
            OrderNumber = await Orders.SuggestOrderNumberAsync(),
            Quantity = 100,
            Priority = 1
        };
        _showEditor = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_quantity is null)
        {
            _errors.Apply(
                ApplicationResult<ProductionOrder>.Validation(
                    [new ValidationIssue(nameof(ProductionOrder.Quantity), "Val_Required")]),
                L);
            return;
        }

        _editing.Quantity = _quantity.Value;
        _editing.ReleaseLocal = PlantTime.Wall(_releaseDate).Date;
        _editing.DueLocal = PlantTime.Wall(_dueDate).Date;

        var isNew = _editing.Id == 0;
        var number = _editing.OrderNumber;
        var result = await Orders.SaveAsync(_editing);
        if (!Apply(result))
            return;

        _showEditor = false;
        Announcer.Say(L[isNew ? "Ann_Created" : "Ann_Saved", number]);
        await ReloadAsync();
    }

    private async Task ReleaseAsync(ProductionOrder order)
    {
        _error = null;
        if (Apply(await Orders.ReleaseAsync(order.Id)))
        {
            Announcer.Say(L["Ann_OrderReleased", order.OrderNumber]);
            await ReloadAsync();
        }
    }

    private void AskCancel(ProductionOrder order)
    {
        _pending = order;
        _showCancel = true;
    }

    private async Task ConfirmCancelAsync()
    {
        _error = null;
        var id = _pending?.Id;
        var number = _pending?.OrderNumber;
        _showCancel = false;
        _pending = null;

        if (id is not null && Apply(await Orders.CancelAsync(id.Value)))
        {
            // The row changes to Cancelled somewhere below the dialog that has just
            // closed. Without this the whole event was silent.
            Announcer.Say(L["Ann_OrderCancelled", number ?? string.Empty]);
            await ReloadAsync();
        }
    }

    private void AskDelete(ProductionOrder order)
    {
        _pending = order;
        _showDelete = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        _error = null;
        var id = _pending?.Id;
        var number = _pending?.OrderNumber;
        _showDelete = false;
        _pending = null;

        if (id is not null && Apply(await Orders.DeleteAsync(id.Value)))
        {
            Announcer.Say(L["Ann_Deleted", number ?? string.Empty]);
            await ReloadAsync();
        }
    }

    /// <summary>
    /// Routes a result to the form. Outside the dialog there is no form, so the
    /// same messages land in the page banner instead of disappearing.
    /// </summary>
    private bool Apply<T>(ApplicationResult<T> result)
    {
        if (result.IsSuccess)
            return true;

        if (_showEditor)
        {
            _errors.Apply(result, L);
            return false;
        }

        _error = result.ValidationIssues is [var issue, ..]
            ? L[issue.MessageKey, issue.Arguments]
            : L[result.Status == ApplicationResultStatus.Forbidden ? "Error_Forbidden" : "Error_ActionFailed"];
        return false;
    }

    private string PlanLabel(WorkPlan plan) => $"{plan.PlanNumber} — {plan.PartName}";

    private string PriorityLabel(int priority) => L[$"Md_Priority_{priority}"];

    private string StatusLabel(ProductionOrderStatus status) => status switch
    {
        ProductionOrderStatus.Draft => L["Orders_StatusDraft"],
        ProductionOrderStatus.Released => L["Orders_StatusReleased"],
        ProductionOrderStatus.Cancelled => L["Orders_StatusCancelled"],
        _ => status.ToString()
    };
}
