@page "/work-plans/new"
@page "/work-plans/{Id:int}"
@using Microsoft.AspNetCore.Components.Routing
@using WorkPlanStudio.Validation
@inject IStringLocalizer<SharedResource> L
@inject WorkPlanService Plans
@inject WorkCenterService Centers
@inject NavigationManager Nav
@inject ILogger<WorkPlanEditor> Logger

<PageTitle>@Title · WorkPlan Studio</PageTitle>

<div class="page-head">
    <div>
        <a class="link back" href="work-plans">← @L["Common_Back"]</a>
        <h1>@Title</h1>
    </div>
    <div class="head-actions">
        @if (!_missing)
        {
            <button class="btn btn-ghost" @onclick="Cancel">@L["Common_Cancel"]</button>
            <AuthorizeView Policy="@Permissions.ManageMasterData">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@L["Common_Save"]</button>
            </AuthorizeView>
        }
    </div>
</div>

<ReadOnlyNotice Policy="@Permissions.ManageMasterData" />

@*
    Both halves of the guard: ConfirmExternalNavigation is the browser's own
    "leave site?" prompt for a reload or a typed address, OnBeforeInternalNavigation
    is ours for a link inside the app. The parameter only takes effect on a
    render, which is why the signature is compared in the render path rather
    than cached in a handler.
*@
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<Modal @bind-Visible="_showLeave" Title="@L["Confirm_LeaveTitle"]">
    <ChildContent>
        <p>@L["Confirm_LeaveBody"]</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="StayOnPage">@L["Confirm_LeaveStay"]</button>
        <button class="btn btn-danger" @onclick="DiscardAndLeaveAsync">@L["Confirm_LeaveDiscard"]</button>
    </Footer>
</Modal>

@if (_loading)
{
    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
}
else if (_missing)
{
    <div class="empty-state" role="status">
        <p>@(string.Format(L["Editor_PlanMissing"], Id))</p>
        <a class="btn btn-primary" href="work-plans">@L["Editor_BackToPlans"]</a>
    </div>
}
else
{
    <MdErrorSummary State="_errors" />

    @*
        Part numbers and revisions are offered, not enforced. Both are copied
        verbatim into every routing snapshot, so two plans for the same part must
        agree letter for letter - but this app has no part master to pick from,
        and a closed list of revisions would refuse the numeric schemes some shops
        use. A datalist over what already exists converges the spellings while
        still letting the first plan for a new part be typed.
    *@
    <datalist id="wp-part-numbers">
        @foreach (var partNumber in _partNumbers)
        {
            <option value="@partNumber"></option>
        }
    </datalist>
    <datalist id="wp-revisions">
        @foreach (var revision in Revisions)
        {
            <option value="@revision"></option>
        }
    </datalist>

    <EditableArea Policy="@Permissions.ManageMasterData">
        <div class="editor-grid">
            <section class="card">
                <div class="card-head"><h2>@L["Editor_HeaderSection"]</h2></div>
                <div class="card-body">
                    <div class="form-grid">
                        <label class="field">
                            <span>@L["Field_PlanNumber"]</span>
                            <input id="wp-number" class="input @_errors.Style("PlanNumber")" maxlength="20"
                                   autocomplete="off" spellcheck="false" autocapitalize="characters"
                                   aria-invalid="@_errors.Invalid("PlanNumber")" aria-describedby="@_errors.DescribedBy("PlanNumber")"
                                   @bind="_model.PlanNumber" @bind:event="oninput" />
                            @if (_errors["PlanNumber"] is { } planNumberError)
                            {
                                <span id="@_errors.ErrorId("PlanNumber")" class="field-error">@planNumberError</span>
                            }
                        </label>
                        <label class="field">
                            <span>@L["Field_Status"]</span>
                            <select id="wp-status" class="input @_errors.Style("Status")"
                                    aria-invalid="@_errors.Invalid("Status")" aria-describedby="@_errors.DescribedBy("Status")"
                                    @bind="_model.Status">
                                @foreach (var s in Enum.GetValues<WorkPlanStatus>())
                                {
                                    <option value="@s">@StatusLabel(s)</option>
                                }
                            </select>
                            @if (_errors["Status"] is { } statusError)
                            {
                                <span id="@_errors.ErrorId("Status")" class="field-error">@statusError</span>
                            }
                        </label>
                        <label class="field">
                            <span>@L["Field_PartNumber"]</span>
                            <input id="wp-part-number" class="input @_errors.Style("PartNumber")" list="wp-part-numbers"
                                   maxlength="40" autocomplete="off" spellcheck="false" autocapitalize="characters"
                                   aria-invalid="@_errors.Invalid("PartNumber")" aria-describedby="@_errors.DescribedBy("PartNumber")"
                                   @bind="_model.PartNumber" @bind:event="oninput" />
                            @if (_errors["PartNumber"] is { } partNumberError)
                            {
                                <span id="@_errors.ErrorId("PartNumber")" class="field-error">@partNumberError</span>
                            }
                        </label>
                        <label class="field">
                            <span>@L["Field_Revision"]</span>
                            <input id="wp-revision" class="input @_errors.Style("Revision")" list="wp-revisions"
                                   maxlength="10" autocomplete="off" spellcheck="false" autocapitalize="characters"
                                   aria-invalid="@_errors.Invalid("Revision")" aria-describedby="@_errors.DescribedBy("Revision")"
                                   @bind="_model.Revision" @bind:event="oninput" />
                            @if (_errors["Revision"] is { } revisionError)
                            {
                                <span id="@_errors.ErrorId("Revision")" class="field-error">@revisionError</span>
                            }
                        </label>
                        <label class="field wide">
                            <span>@L["Field_PartName"]</span>
                            <input id="wp-part" class="input @_errors.Style("PartName")" maxlength="120"
                                   aria-invalid="@_errors.Invalid("PartName")" aria-describedby="@_errors.DescribedBy("PartName")"
                                   @bind="_model.PartName" @bind:event="oninput" />
                            @if (_errors["PartName"] is { } partNameError)
                            {
                                <span id="@_errors.ErrorId("PartName")" class="field-error">@partNameError</span>
                            }
                        </label>
                        <label class="field">
                            <span>@L["Field_LotSize"]</span>
                            <input id="wp-lot" class="input @_errors.Style("LotSize")"
                                   type="number" min="1" max="1000000" inputmode="numeric"
                                   aria-invalid="@_errors.Invalid("LotSize")" aria-describedby="@_errors.DescribedBy("LotSize")"
                                   @bind="_lotSize" @bind:event="oninput" />
                            @if (_errors["LotSize"] is { } lotSizeError)
                            {
                                <span id="@_errors.ErrorId("LotSize")" class="field-error">@lotSizeError</span>
                            }
                        </label>
                    </div>
                </div>
            </section>

            <section class="card summary-card">
                <div class="card-head"><h2>@L["Editor_Summary"]</h2></div>
                <div class="card-body">
                    <dl class="summary">
                        <div><dt>@L["Editor_SetupSum"]</dt><dd>@Format.Minutes(SetupSum)</dd></div>
                        <div><dt>@L["Editor_UnitSum"]</dt><dd>@Format.Minutes(UnitSum)</dd></div>
                        <div><dt>@L["Editor_LotTime"]</dt><dd>@Format.Hours(LotTime)</dd></div>
                        <div class="highlight"><dt>@L["Editor_LotCost"]</dt><dd>@Format.Euro(LotCost)</dd></div>
                    </dl>
                </div>
            </section>
        </div>

        <section id="wp-operations" class="card no-pad">
            <div class="card-head pad">
                <h2>@L["Editor_OperationsSection"]</h2>
                <button class="btn btn-outline" @onclick="AddOperation">
                    <span class="btn-plus">+</span> @L["Editor_AddOperation"]
                </button>
            </div>

            @if (_errors["Operations"] is { } operationsError)
            {
                <div class="form-banner error">@operationsError</div>
            }

            @if (_rows.Count == 0)
            {
                <div class="empty-state small">
                    <p>@L["Editor_NoOperations"]</p>
                </div>
            }
            else
            {
                <table class="data-table op-table">
                    <thead>
                        <tr>
                            <th scope="col" class="num narrow">@L["Field_OperationNo"]</th>
                            <th scope="col" class="wc-col">@L["Field_WorkCenter"]</th>
                            <th scope="col">@L["Field_Description"]</th>
                            <th scope="col" class="num">@L["Field_SetupTime"]</th>
                            <th scope="col" class="num">@L["Field_TimePerPiece"]</th>
                            <th scope="col">@L["Field_Remarks"]</th>
                            <th scope="col"><span class="sr-only">@L["Common_Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr @key="row.Key">
                                <td class="num narrow">
                                    <input class="input mini num @CellStyle(row, nameof(row.OperationNumber))"
                                           type="number" min="1" step="10" inputmode="numeric"
                                           aria-label="@L["Field_OperationNo"]"
                                           aria-invalid="@CellInvalid(row, nameof(row.OperationNumber))"
                                           aria-describedby="@CellDescribedBy(row, nameof(row.OperationNumber))"
                                           @bind="row.OperationNumber" @bind:event="oninput" />
                                    @if (CellError(row, nameof(row.OperationNumber)) is { } operationnumberError)
                                    {
                                        <span id="@CellErrorId(row, nameof(row.OperationNumber))" class="sr-only">@operationnumberError</span>
                                    }
                                </td>
                                <td class="wc-col">
                                    <EntityPicker TItem="WorkCenter" Id="@($"op-{row.Key}-center")"
                                                  Items="_workCenters"
                                                  Value="row.WorkCenterId"
                                                  ValueChanged="value => row.WorkCenterId = value"
                                                  IdOf="w => w.Id"
                                                  LabelOf="CenterLabel"
                                                  IsActive="w => w.IsActive"
                                                  Invalid="@IsBad(row, nameof(row.WorkCenterId))"
                                                  DescribedBy="@CellDescribedBy(row, nameof(row.WorkCenterId))"
                                                  AriaLabel="@L["Field_WorkCenter"]" />
                                </td>
                                <td>
                                    <input class="input @CellStyle(row, nameof(row.Description))" maxlength="120"
                                           aria-label="@L["Field_Description"]"
                                           aria-invalid="@CellInvalid(row, nameof(row.Description))"
                                           aria-describedby="@CellDescribedBy(row, nameof(row.Description))"
                                           @bind="row.Description" @bind:event="oninput" />
                                    @if (CellError(row, nameof(row.Description)) is { } descriptionError)
                                    {
                                        <span id="@CellErrorId(row, nameof(row.Description))" class="sr-only">@descriptionError</span>
                                    }
                                </td>
                                <td class="num">
                                    <input class="input mini num @CellStyle(row, nameof(row.SetupTimeMinutes))"
                                           type="number" min="0" step="0.01" inputmode="decimal"
                                           aria-label="@L["Field_SetupTime"]"
                                           aria-invalid="@CellInvalid(row, nameof(row.SetupTimeMinutes))"
                                           aria-describedby="@CellDescribedBy(row, nameof(row.SetupTimeMinutes))"
                                           @bind="row.SetupTimeMinutes" @bind:event="oninput" />
                                    @if (CellError(row, nameof(row.SetupTimeMinutes)) is { } setuptimeminutesError)
                                    {
                                        <span id="@CellErrorId(row, nameof(row.SetupTimeMinutes))" class="sr-only">@setuptimeminutesError</span>
                                    }
                                </td>
                                <td class="num">
                                    <input class="input mini num @CellStyle(row, nameof(row.TimePerPieceMinutes))"
                                           type="number" min="0" step="0.01" inputmode="decimal"
                                           aria-label="@L["Field_TimePerPiece"]"
                                           aria-invalid="@CellInvalid(row, nameof(row.TimePerPieceMinutes))"
                                           aria-describedby="@CellDescribedBy(row, nameof(row.TimePerPieceMinutes))"
                                           @bind="row.TimePerPieceMinutes" @bind:event="oninput" />
                                    @if (CellError(row, nameof(row.TimePerPieceMinutes)) is { } timeperpieceminutesError)
                                    {
                                        <span id="@CellErrorId(row, nameof(row.TimePerPieceMinutes))" class="sr-only">@timeperpieceminutesError</span>
                                    }
                                </td>
                                <td>
                                    <input class="input @CellStyle(row, nameof(row.Remarks))" maxlength="250"
                                           aria-label="@L["Field_Remarks"]"
                                           aria-invalid="@CellInvalid(row, nameof(row.Remarks))"
                                           aria-describedby="@CellDescribedBy(row, nameof(row.Remarks))"
                                           @bind="row.Remarks" @bind:event="oninput" />
                                    @if (CellError(row, nameof(row.Remarks)) is { } remarksError)
                                    {
                                        <span id="@CellErrorId(row, nameof(row.Remarks))" class="sr-only">@remarksError</span>
                                    }
                                </td>
                                <td class="actions-col">
                                    <button class="icon-btn danger" aria-label="@L["Common_Delete"]" title="@L["Common_Delete"]" @onclick="() => RemoveOperation(row)">
                                        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </EditableArea>
}

@code {
    [Parameter] public int? Id { get; set; }

    /// <summary>
    /// One row of the operations table. Its numbers are nullable so that clearing
    /// a box means "empty" rather than "keep whatever was there" — with a
    /// non-nullable target Blazor reverts the unparsable empty string, the DOM
    /// keeps showing nothing, and the old value is what gets saved.
    /// </summary>
    private sealed class OperationRow
    {
        private static int _nextKey;

        public int Key { get; } = ++_nextKey;
        public int? OperationNumber { get; set; }
        public int? WorkCenterId { get; set; }
        public string Description { get; set; } = "";
        public decimal? SetupTimeMinutes { get; set; }
        public decimal? TimePerPieceMinutes { get; set; }
        public string? Remarks { get; set; }

        public Operation ToOperation() => new()
        {
            OperationNumber = OperationNumber ?? 0,
            WorkCenterId = WorkCenterId ?? 0,
            Description = Description,
            SetupTimeMinutes = SetupTimeMinutes ?? 0m,
            TimePerPieceMinutes = TimePerPieceMinutes ?? 0m,
            Remarks = Remarks
        };

        public static OperationRow From(Operation operation) => new()
        {
            OperationNumber = operation.OperationNumber,
            WorkCenterId = operation.WorkCenterId == 0 ? null : operation.WorkCenterId,
            Description = operation.Description,
            SetupTimeMinutes = operation.SetupTimeMinutes,
            TimePerPieceMinutes = operation.TimePerPieceMinutes,
            Remarks = operation.Remarks
        };
    }

    private bool _loading = true;
    private bool _missing;
    private WorkPlan _model = new() { Status = WorkPlanStatus.Draft, LotSize = 1 };
    private readonly List<OperationRow> _rows = [];
    private int? _lotSize;
    private List<WorkCenter> _workCenters = new();
    private List<string> _partNumbers = [];
    private readonly FormErrorState _errors = new();
    private bool _saving;

    // What the form looked like when it was loaded or last saved. Comparing the
    // whole of it beats a flag set by an event handler: it cannot miss a binding
    // that fires somewhere unexpected, and it says "clean" again when an edit is
    // typed and then undone, which a flag never does.
    private string _savedSignature = "";
    private bool _showLeave;
    private string? _pendingLocation;

    // Which plan the form is currently showing, as opposed to which one the
    // address asks for. They disagree exactly once per navigation, and closing
    // that gap is what OnParametersSetAsync is for.
    private int? _loadedId;
    private bool _loaded;

    // A page that has no form cannot have unsaved work on it, so the missing-plan
    // dead end must not arm the guard: it used to compare an empty model against
    // an empty signature and conclude the reader had something to lose.
    private bool IsDirty => !_loading && !_missing && Signature() != _savedSignature;

    private string Signature() => string.Join('',
        _model.PlanNumber, _model.Status, _model.PartNumber, _model.Revision, _model.PartName, _lotSize,
        string.Join('', _rows.Select(row => string.Join('|',
            row.OperationNumber, row.WorkCenterId, row.Description,
            row.SetupTimeMinutes, row.TimePerPieceMinutes, row.Remarks))));

    private bool IsNew => Id is null;
    private string Title => IsNew ? L["Editor_NewTitle"] : L["Editor_EditTitle"];

    /// <summary>Revision letters offered by the datalist, plus anything already in use.</summary>
    private IEnumerable<string> Revisions =>
        Enumerable.Range(0, 26).Select(i => ((char)('A' + i)).ToString())
            .Concat(string.IsNullOrWhiteSpace(_model.Revision) ? Array.Empty<string>() : [_model.Revision])
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private static string CenterLabel(WorkCenter center) => $"{center.Code} — {center.Name}";

    protected override void OnInitialized()
    {
        _errors.Declare("PlanNumber", "wp-number");
        _errors.Declare("Status", "wp-status");
        _errors.Declare("PartNumber", "wp-part-number");
        _errors.Declare("Revision", "wp-revision");
        _errors.Declare("PartName", "wp-part");
        _errors.Declare("LotSize", "wp-lot");
        _errors.Declare("Operations", "wp-operations");
    }

    /// <summary>
    /// The router keeps one instance of this page alive across
    /// <c>/work-plans/1</c> → <c>/work-plans/2</c> → <c>/work-plans/new</c>,
    /// because only the route parameter changes. Loading in
    /// <c>OnInitializedAsync</c> therefore ran exactly once: every plan after the
    /// first was drawn with the first one's numbers, and <c>Save</c> wrote them
    /// to whichever id the address happened to carry.
    /// <para>
    /// The guard is the other half. This method also runs whenever a cascading
    /// value changes — switching persona, for one — and reloading there would
    /// throw away whatever the user had typed. So it reloads when, and only when,
    /// the id it is showing is not the id it was asked for.
    /// </para>
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedId == Id)
            return;

        _loadedId = Id;
        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Everything that belongs to one plan starts again; anything left behind
        // here is the previous plan speaking through this one's page.
        _loading = true;
        _missing = false;
        _saving = false;
        _showLeave = false;
        _pendingLocation = null;
        _errors.Clear();
        _rows.Clear();

        _workCenters = await Centers.GetAllAsync();
        _partNumbers = await Plans.GetPartNumbersAsync();

        if (IsNew)
        {
            _model = new WorkPlan
            {
                Status = WorkPlanStatus.Draft,
                LotSize = 100,
                PlanNumber = await Plans.SuggestPlanNumberAsync()
            };
        }
        else
        {
            var existing = await Plans.GetAsync(Id!.Value);
            if (existing is null)
            {
                // A bookmark from before a delete, or a number someone typed.
                // Handing back an empty form pretends the plan is there and only
                // admits otherwise once Save has been pressed.
                _model = new WorkPlan { Status = WorkPlanStatus.Draft, LotSize = 1 };
                _lotSize = _model.LotSize;
                _missing = true;
                _loading = false;
                _savedSignature = Signature();
                return;
            }

            _model = existing;
        }

        _lotSize = _model.LotSize;
        _rows.AddRange(_model.Operations.OrderBy(o => o.OperationNumber).Select(OperationRow.From));
        _loading = false;
        _savedSignature = Signature();
    }

    // ----- live summary -----
    private decimal SetupSum => _rows.Sum(o => o.SetupTimeMinutes ?? 0m);
    private decimal UnitSum => _rows.Sum(o => o.TimePerPieceMinutes ?? 0m);
    private decimal LotTime => _rows.Sum(o => (o.SetupTimeMinutes ?? 0m) + (o.TimePerPieceMinutes ?? 0m) * (_lotSize ?? 0));
    private decimal LotCost => _rows.Sum(o =>
        ((o.SetupTimeMinutes ?? 0m) + (o.TimePerPieceMinutes ?? 0m) * (_lotSize ?? 0)) / 60m * RateOf(o.WorkCenterId));

    private decimal RateOf(int? workCenterId) =>
        _workCenters.FirstOrDefault(w => w.Id == workCenterId)?.HourlyRate ?? 0m;

    private string StatusLabel(WorkPlanStatus s) => s switch
    {
        WorkPlanStatus.Draft => L["Status_Draft"],
        WorkPlanStatus.Released => L["Status_Released"],
        WorkPlanStatus.Archived => L["Status_Archived"],
        _ => s.ToString()
    };

    private void AddOperation()
    {
        var next = _rows.Count == 0 ? 10 : _rows.Max(o => o.OperationNumber ?? 0) + 10;
        _rows.Add(new OperationRow { OperationNumber = next, SetupTimeMinutes = 0m, TimePerPieceMinutes = 0m });
    }

    private void RemoveOperation(OperationRow row) => _rows.Remove(row);

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (_lotSize is null)
            {
                _errors.Apply(
                    ApplicationResult<int>.Validation([new ValidationIssue(nameof(WorkPlan.LotSize), "Val_Required")]),
                    L);
                return;
            }

            _model.LotSize = _lotSize.Value;
            _model.Operations = _rows.Select(row => row.ToOperation()).ToList();

            var result = IsNew
                ? await Plans.CreateAsync(_model)
                : await Plans.UpdateAsync(_model);

            if (result.IsSuccess)
            {
                _errors.Clear();
                _savedSignature = Signature();
                Nav.NavigateTo("work-plans");
                return;
            }

            _errors.Apply(Describe(result), L);
        }
        catch (OperationCanceledException)
        {
            _errors.Fail(L["Error_Cancelled"]);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Saving work plan {WorkPlanId} failed", _model.Id);
            _errors.Fail(L["Error_SaveFailed"]);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Operation issues arrive as <c>Operations[10].Description</c>. They share one
    /// banner above the table, so the field becomes <c>Operations</c> — but the row
    /// and the column are not thrown away: they go into the sentence, so the summary
    /// says which operation and which column instead of the bare word "Required",
    /// and into <see cref="_badCells"/>, so the cell itself can be marked.
    /// </summary>
    private ApplicationResult<int> Describe(ApplicationResult<int> result)
    {
        _badCells.Clear();
        if (result.ValidationIssues is null)
            return result;

        var described = new List<ValidationIssue>(result.ValidationIssues.Count);
        foreach (var issue in result.ValidationIssues)
        {
            var (number, column) = OperationCell(issue.Field);
            if (column is null)
            {
                described.Add(issue);
                continue;
            }

            var reason = L[issue.MessageKey, issue.Arguments ?? []].Value;
            _badCells.TryAdd((number, column), reason);
            described.Add(new ValidationIssue(
                "Operations",
                "Val_InOperation",
                number,
                ColumnLabel(column),
                reason));
        }

        return result with { ValidationIssues = described };
    }

    /// <summary>Splits <c>Operations[10].Description</c> into its row and its column.</summary>
    private static (int Number, string? Column) OperationCell(string field)
    {
        if (!field.StartsWith("Operations[", StringComparison.Ordinal))
            return (0, null);

        var close = field.IndexOf(']', StringComparison.Ordinal);
        var dot = field.IndexOf('.', StringComparison.Ordinal);
        if (close < 0 || dot < close || !int.TryParse(field.AsSpan(11, close - 11), out var number))
            return (0, null);

        return (number, field[(dot + 1)..]);
    }

    private string ColumnLabel(string column) => column switch
    {
        nameof(Operation.OperationNumber) => L["Field_OperationNo"],
        nameof(Operation.WorkCenterId) => L["Field_WorkCenter"],
        nameof(Operation.Description) => L["Field_Description"],
        nameof(Operation.SetupTimeMinutes) => L["Field_SetupTime"],
        nameof(Operation.TimePerPieceMinutes) => L["Field_TimePerPiece"],
        nameof(Operation.Remarks) => L["Field_Remarks"],
        _ => column
    };

    /// <summary>
    /// Row number and column of every cell the last save complained about.
    /// <para>
    /// Keyed by the operation <em>number</em>, because that is what the validator
    /// names — which means two rows claiming the same number are both marked for
    /// everything said about it. That is the truthful rendering rather than a
    /// miss: "operation 10" is ambiguous exactly when the reader has two of them,
    /// and the first line of the summary is the duplicate number itself.
    /// </para>
    /// </summary>
    private readonly Dictionary<(int Number, string Column), string> _badCells = [];

    private string? CellError(OperationRow row, string column) =>
        row.OperationNumber is { } number ? _badCells.GetValueOrDefault((number, column)) : null;

    private bool IsBad(OperationRow row, string column) => CellError(row, column) is not null;

    private string? CellStyle(OperationRow row, string column) => IsBad(row, column) ? "error" : null;

    private string CellInvalid(OperationRow row, string column) => IsBad(row, column) ? "true" : "false";

    /// <summary>
    /// The id of a cell's reason. <c>aria-invalid</c> on its own says "wrong"
    /// without saying why, and the sentence one line above the table is not tied
    /// to the cell a keyboard lands on — so each bad cell carries its own,
    /// announced but not drawn, because sixty cells have no room for sixty
    /// sentences.
    /// </summary>
    private static string CellErrorId(OperationRow row, string column) => $"op-{row.Key}-{column}-error";

    private string? CellDescribedBy(OperationRow row, string column) =>
        IsBad(row, column) ? CellErrorId(row, column) : null;

    /// <summary>
    /// Cancel already means "throw this away", so it says so once and leaves.
    /// Asking again would train the habit of clicking past the question.
    /// </summary>
    private void Cancel()
    {
        _savedSignature = Signature();
        Nav.NavigateTo("work-plans");
    }

    /// <summary>Holds an internal navigation while the page asks whether the edit may go.</summary>
    private void ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!IsDirty)
            return;

        context.PreventNavigation();
        _pendingLocation = context.TargetLocation;
        _showLeave = true;
    }

    private void StayOnPage()
    {
        _showLeave = false;
        _pendingLocation = null;
    }

    private void DiscardAndLeaveAsync()
    {
        _showLeave = false;
        _savedSignature = Signature();
        if (_pendingLocation is { } location)
            Nav.NavigateTo(location);
    }
}
