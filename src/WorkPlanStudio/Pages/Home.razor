@page "/"
@using System.Globalization
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject WorkPlanService Plans
@inject WorkCenterService Centers
@inject PlantSettingsService Settings
@inject IProductionScheduleService Scheduler
@inject DemoAuthenticationStateProvider Auth
@inject NavigationManager Nav

<PageTitle>WorkPlan Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Dashboard_Title"]</h1>
        <p class="page-sub">@L["Dashboard_Subtitle"]</p>
    </div>
</div>

@if (_loading)
{
    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
}
else
{
    <div class="stat-grid">
        <div class="stat-card accent-indigo">
            <div class="stat-top">
                <span class="stat-value">@_plans.Count</span>
                <svg class="stat-icon" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4v2h6V4" /><path d="M9 11h6M9 15h4" /></svg>
            </div>
            <div class="stat-label">@L["Dashboard_TotalPlans"]</div>
        </div>
        <div class="stat-card accent-green">
            <div class="stat-top">
                <span class="stat-value">@Count(WorkPlanStatus.Released)</span>
                <svg class="stat-icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
            </div>
            <div class="stat-label">@L["Dashboard_Released"]</div>
        </div>
        <div class="stat-card accent-amber">
            <div class="stat-top">
                <span class="stat-value">@_workCenters</span>
                <svg class="stat-icon" viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1" /><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3" /></svg>
            </div>
            <div class="stat-label">@L["Dashboard_WorkCenters"]</div>
        </div>
        <div class="stat-card accent-slate">
            <div class="stat-top">
                <span class="stat-value">@TotalOperations</span>
                <svg class="stat-icon" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
            </div>
            <div class="stat-label">@L["Dashboard_Operations"]</div>
        </div>
    </div>

    <div class="dash-columns">
        <section class="card">
            <div class="card-head"><h2>@L["Dashboard_ByStatus"]</h2></div>
            <div class="card-body">
                <div class="status-bar">
                    @foreach (var s in _statuses)
                    {
                        var count = Count(s);
                        <div class="status-seg status-@s.ToString().ToLowerInvariant()" style="flex:@(count)"></div>
                    }
                </div>
                <ul class="legend">
                    @foreach (var s in _statuses)
                    {
                        <li>
                            <StatusBadge Status="s" />
                            <span class="legend-count">@Count(s)</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section class="card">
            <div class="card-head">
                <h2>@L["Dashboard_Recent"]</h2>
                <a class="link" href="work-plans">@L["Dashboard_ViewAll"]</a>
            </div>
            <div class="card-body no-pad">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Field_PlanNumber"]</th>
                            <th scope="col">@L["Field_PartName"]</th>
                            <th scope="col">@L["Field_Status"]</th>
                            <th scope="col" class="num">@L["Field_TotalTime"]</th>
                            <th scope="col" class="num">@L["Field_Modified"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Recent)
                        {
                            <tr class="clickable" @onclick="() => Open(p.Id)">
                                <td><span class="mono">@p.PlanNumber</span></td>
                                <td>@p.PartName</td>
                                <td><StatusBadge Status="p.Status" /></td>
                                <td class="num">@Format.Hours(p.TotalTimeMinutes)</td>
                                <td class="num muted">@p.ModifiedUtc.ToString("d")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="dash-columns glance">
        <section class="card glance-plant">
            <div class="card-head"><h2>@L["Dashboard_PlantTitle"]</h2></div>
            <div class="card-body">
                <dl class="glance-list">
                    <div>
                        <dt>@L["Dashboard_PlantState"]</dt>
                        <dd>@_state.Name() <span class="muted">(@_state)</span></dd>
                    </div>
                    <div>
                        <dt>@L["Dashboard_NextHoliday"]</dt>
                        <dd>
                            @if (_nextHoliday is { } holiday)
                            {
                                @L[$"Holiday_{holiday.Key}"] <span class="muted">· @holiday.Date.ToString("ddd d. MMM", CultureInfo.CurrentUICulture)</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@L["Dashboard_StaffedCenters"]</dt>
                        <dd>@_staffedCenters <span class="muted">/ @_workCenters</span></dd>
                    </div>
                    <div>
                        <dt>@L["Dashboard_Persona"]</dt>
                        <dd>@L[$"Role_{Auth.CurrentRole}"]</dd>
                    </div>
                </dl>
                <p class="glance-foot" style="margin-top:1rem"><a class="link" href="working-time">@L["Nav_WorkingTime"] →</a></p>
            </div>
        </section>

        <section class="card glance-schedule">
            <div class="card-head"><h2>@L["Dashboard_ScheduleTitle"]</h2></div>
            <div class="card-body">
                @if (_schedule is null)
                {
                    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
                }
                else if (!_schedule.HasData)
                {
                    <p class="muted small-text">@L["Dashboard_ScheduleEmpty"]</p>
                }
                else
                {
                    <div class="glance-kpis">
                        <div class="glance-kpi">
                            <strong>@((_schedule.Kpis.OnTimeRate * 100).ToString("0")) %</strong>
                            <span>@L["Sched_KpiOnTime"] · @(_schedule.Kpis.JobCount - _schedule.Kpis.LateJobCount)/@_schedule.Kpis.JobCount</span>
                        </div>
                        <div class="glance-kpi">
                            <strong>@Format.Hours(_schedule.Kpis.MakespanSeconds / 60m)</strong>
                            <span>@L["Sched_KpiMakespan"]</span>
                        </div>
                        <div class="glance-kpi @(_schedule.Kpis.LateJobCount > 0 ? "late" : null)">
                            <strong>@_schedule.Kpis.LateJobCount</strong>
                            <span>@L["Dashboard_LateOrders"]</span>
                        </div>
                    </div>
                    <div class="glance-foot">
                        <span class="muted">@L["Dashboard_ScheduleNote"]</span>
                        <a class="btn btn-outline btn-sm" href="schedule">@L["Dashboard_OpenSchedule"]</a>
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private List<WorkPlan> _plans = new();
    private int _workCenters;
    private int _staffedCenters;
    private GermanState _state = GermanState.NW;
    private PublicHoliday? _nextHoliday;
    private ScheduleResult? _schedule;

    private readonly WorkPlanStatus[] _statuses =
    {
        WorkPlanStatus.Draft, WorkPlanStatus.Released, WorkPlanStatus.Archived
    };

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnPersonaChanged;
        await Auth.GetAuthenticationStateAsync();   // loads the stored persona before CurrentRole is read

        _plans = await Plans.GetAllAsync();
        var centers = await Centers.GetAllAsync();
        _workCenters = centers.Count;
        _staffedCenters = centers.Count(c => c.ShiftPatternKey != ShiftPatterns.Continuous.Key);

        var rules = (await Settings.GetAsync()).ToRules();
        _state = rules.State;
        // "Next" relative to the demo's planning horizon rather than the wall
        // clock, so the dashboard reads the same on every visit and in every test.
        var today = new DateOnly(2026, 6, 1);
        _nextHoliday = GermanHolidays.Between(today, today.AddYears(1), rules.State, rules.IncludePartialHolidays).FirstOrDefault();
        _loading = false;

        // The schedule is computed after the first render so the page is usable immediately.
        StateHasChanged();
        _schedule = await Scheduler.GenerateAsync(new SchedulingParameters { DueDateRule = DueDateRule.Explicit });   // the Scheduling page's defaults
    }

    private void OnPersonaChanged(Task<AuthenticationState> task) => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.AuthenticationStateChanged -= OnPersonaChanged;

    private int Count(WorkPlanStatus status) => _plans.Count(p => p.Status == status);
    private int TotalOperations => _plans.Sum(p => p.OperationCount);
    private IEnumerable<WorkPlan> Recent => _plans.OrderByDescending(p => p.ModifiedUtc).Take(5);

    private void Open(int id) => Nav.NavigateTo($"work-plans/{id}");
}
