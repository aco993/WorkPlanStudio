@page "/working-time"
@using System.Globalization
@using WorkPlanStudio.Validation
@inject IStringLocalizer<SharedResource> L
@inject PlantSettingsService Settings
@inject WorkCenterService Centers
@inject ILogger<WorkingTimePage> Logger

<PageTitle>@L["WorkingTime_Title"] · WorkPlan Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["WorkingTime_Title"]</h1>
        <p class="page-sub">@L["WorkingTime_Subtitle"]</p>
    </div>
</div>

@if (_loading)
{
    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
}
else
{
    @if (_error is not null)
    {
        <div class="form-banner error" role="alert">@_error</div>
    }
    @if (_saved)
    {
        <div class="form-banner success" role="status">@L["WorkingTime_Saved"]</div>
    }

    <div class="wt-layout">
        <section class="card wt-rules">
            <div class="card-head"><h2>@L["WorkingTime_PlantRules"]</h2></div>
            <div class="card-body">
                <EditableArea Policy="@Permissions.ManagePlantRules">
                    <div class="form-grid">
                        <label class="field wide">
                            <span>@L["WorkingTime_State"]</span>
                            <select id="wt-state" class="input" @bind="_form.State" @bind:after="Recompute">
                                @foreach (var state in GermanStates.All)
                                {
                                    <option value="@state">@state.Name() (@state)</option>
                                }
                            </select>
                        </label>
                        <label class="field check wide">
                            <input type="checkbox" @bind="_form.IncludePartialHolidays" @bind:after="Recompute" />
                            <span>@L["WorkingTime_IncludePartial"]</span>
                        </label>
                        <label class="field check wide">
                            <input type="checkbox" @bind="_form.AllowExtendedDay" @bind:after="Recompute" />
                            <span>@L["WorkingTime_AllowExtendedDay"]</span>
                        </label>
                        <label class="field check wide">
                            <input type="checkbox" @bind="_form.AllowExtendedNight" @bind:after="Recompute" />
                            <span>@L["WorkingTime_AllowExtendedNight"]</span>
                        </label>
                        <label class="field wide">
                            <span>@L["Wt_AveragingWindow"]</span>
                            <select id="wt-window" class="input" @bind="_form.AveragingWindow" @bind:after="Recompute">
                                @foreach (var window in Enum.GetValues<AveragingWindow>())
                                {
                                    <option value="@window">@L.WindowName(window)</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue(nameof(PlantSettings.AveragingWindow), out var windowError))
                            {
                                <span class="field-error">@windowError</span>
                            }
                        </label>
                        <label class="field check wide">
                            <input id="wt-sunday" type="checkbox" @bind="_form.SundayWorkAllowed" @bind:after="Recompute" />
                            <span>@L["WorkingTime_SundayWork"]</span>
                        </label>
                        <label class="field check wide">
                            <input type="checkbox" @bind="_form.HolidayWorkAllowed" @bind:after="Recompute" />
                            <span>@L["WorkingTime_HolidayWork"]</span>
                        </label>
                        <label class="field">
                            <span>@L["WorkingTime_BoundaryShift"]</span>
                            <span class="input-unit">
                                <input class="input num" type="number" inputmode="numeric" min="0" max="6" @bind="_form.SundayBoundaryShiftHours" @bind:after="Recompute" />
                                <span>@L["WorkingTime_Hours"]</span>
                            </span>
                            @if (_formErrors.TryGetValue("SundayBoundaryShiftHours", out var shiftError))
                            {
                                <span class="field-error">@shiftError</span>
                            }
                        </label>
                        @*
                            § 11 (1) divides the year's Sundays by the rota, so the
                            rota only means anything once Sunday work is permitted at
                            all. It appears with that permission and is announced.
                        *@
                        @if (_form.SundayWorkAllowed)
                        {
                            <label class="field">
                                <span>@L["Wt_SundayRotation"]</span>
                                <span class="input-unit">
                                    <input id="wt-rotation" class="input num" type="number" inputmode="numeric" min="1" max="52"
                                           aria-describedby="wt-rotation-hint"
                                           @bind="_form.SundayRotationWeeks" @bind:after="Recompute" />
                                    <span>@L["Wt_WeeksUnit"]</span>
                                </span>
                                @if (_formErrors.TryGetValue(nameof(PlantSettings.SundayRotationWeeks), out var rotationError))
                                {
                                    <span class="field-error">@rotationError</span>
                                }
                            </label>
                            <p id="wt-rotation-hint" class="muted small-text wide">@L["Wt_SundayRotationHint"]</p>
                        }

                        <label class="field wide">
                            <span>@L["Wt_RestSector"]</span>
                            <select id="wt-sector" class="input" @bind="_form.RestExceptionSector" @bind:after="Recompute">
                                @foreach (var sector in Enum.GetValues<RestExceptionSector>())
                                {
                                    <option value="@sector">@L.SectorName(sector)</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue(nameof(PlantSettings.RestExceptionSector), out var sectorError))
                            {
                                <span class="field-error">@sectorError</span>
                            }
                        </label>
                        <label class="field">
                            <span>@L["WorkingTime_MinimumRest"]</span>
                            @*
                                Ten hours is not a number a plant may dial in; it is an
                                entitlement of the sectors § 5 (2) names. So it is not
                                an option here until one of them is declared — and the
                                validator and a CHECK constraint say the same, because
                                a control that is merely hidden still grants it.
                            *@
                            <select id="wt-rest" class="input" aria-describedby="wt-rest-note"
                                    @bind="_form.MinimumRestHours" @bind:after="Recompute">
                                <option value="11">11 @L["WorkingTime_Hours"]</option>
                                @if (_form.RestExceptionSector != RestExceptionSector.None)
                                {
                                    <option value="10">10 @L["WorkingTime_Hours"]</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue("MinimumRestHours", out var restError))
                            {
                                <span class="field-error">@restError</span>
                            }
                        </label>
                        <p id="wt-rest-note" class="muted small-text wide">
                            @(_form.RestExceptionSector == RestExceptionSector.None
                                ? L["Wt_RestNoSector"].Value
                                : string.Format(Culture, L["Wt_RestCompensationNote"], Span(WorkingTimeRules.Statutory.CompensatingRest)))
                        </p>
                    </div>
                </EditableArea>
                <p class="sr-only" role="status" aria-live="polite">@_ruleAnnouncement</p>
                <div class="head-actions wt-actions">
                    <AuthorizeView Policy="@Permissions.ManagePlantRules">
                        <Authorized>
                            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@L["Common_Save"]</button>
                        </Authorized>
                        <NotAuthorized>
                            <ReadOnlyNotice Policy="@Permissions.ManagePlantRules" />
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-head">
                <h2>@L["WorkingTime_Preview"]</h2>
                <label class="field inline">
                    <span class="sr-only">@L["WorkingTime_PreviewFor"]</span>
                    <select id="wt-pattern" class="input mini" @bind="_previewKey" @bind:after="Recompute">
                        @foreach (var pattern in ShiftPatterns.Presets)
                        {
                            <option value="@pattern.Key">@L[$"Shift_{pattern.Key}"]</option>
                        }
                    </select>
                </label>
                <label class="field inline">
                    <span class="sr-only">@L["Wt_OperatingDays"]</span>
                    <select id="wt-days" class="input mini" @bind="_previewDays" @bind:after="Recompute">
                        @foreach (var days in Enum.GetValues<PreviewDays>())
                        {
                            <option value="@days">@L[$"Wt_Days_{days}"]</option>
                        }
                    </select>
                </label>
            </div>
            <div class="card-body">
                <p class="hint">@L["WorkingTime_PreviewNote"]</p>
                @if (_preview is not null)
                {
                    <WeekStrip Timeline="_preview" />
                    <ul class="legend legend-inline">
                        @foreach (var kind in new[] { SegmentKind.Working, SegmentKind.Break, SegmentKind.OffShift, SegmentKind.Rest, SegmentKind.Sunday })
                        {
                            <li><span class="week-swatch seg-@kind.ToString().ToLowerInvariant()"></span>@L[$"Segment_{kind}"]</li>
                        }
                    </ul>
                    <p class="wt-summary">
                        <strong>@string.Format(L["WorkingTime_WeeklyHours"], Hours(_preview.WeeklyWorkingSeconds))</strong>
                        <span> · @string.Format(Culture, L["Wt_PreviewPeriod"], Format.Date(_preview.From), Format.Date(_preview.To.AddDays(-1)))</span>
                    </p>

                    <h3 class="about-sub">@L["Wt_SundayRest"]</h3>
                    <ul class="assistant-lines">
                        <li class="assistant-line @SundayTone">
                            <span class="assistant-dot"></span>
                            <span><span class="pill law">@WorkingTimeText.LegalReference(WorkingTimeRuleId.FreeSundays)</span> @SundaySentence(_preview)</span>
                        </li>
                    </ul>
                    @if (_preview.ViolatesFreeSundays)
                    {
                        <p class="assistant-note">@string.Format(L["WorkingTime_FreeSundaysViolation"], _preview.Rules.MinimumFreeSundaysPerYear, _preview.FreeSundays(_holidayYear))</p>
                    }

                    <h3 class="about-sub">@L["WorkingTime_RulesApplied"]</h3>
                    @if (_preview.Applications.Count == 0)
                    {
                        <p class="muted small-text">@L["WorkingTime_NoRules"]</p>
                    }
                    else
                    {
                        <ul class="assistant-lines wt-applications">
                            @foreach (var group in GroupedApplications(_preview))
                            {
                                <li class="assistant-line tone-info">
                                    <span class="assistant-dot"></span>
                                    <span><span class="pill law">@group.Sample.LegalReference</span> @Describe(group.Sample, group.Days)</span>
                                </li>
                            }
                        </ul>
                    }
                }
                <p class="sr-only" role="status" aria-live="polite">@_resultAnnouncement</p>
            </div>
        </section>
    </div>

    <section class="card no-pad">
        <div class="card-head pad">
            <div>
                <h2>@L["Wt_Averaging"]</h2>
                <p class="page-sub">@L["Wt_AveragingNote"]</p>
            </div>
        </div>
        @if (Averaging().Count == 0)
        {
            <div class="empty-state small"><p>@L["Wt_AveragingNone"]</p></div>
        }
        else
        {
            <TableScroll Label="@L["Wt_Averaging"]">
                <table class="data-table wt-averaging">
                    <caption class="sr-only">@L["Wt_Averaging"]</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="sticky-col">@L["Wt_ColCrew"]</th>
                            <th scope="col">@L["Wt_ColRule"]</th>
                            <th scope="col">@L["Wt_ColAverage"]</th>
                            <th scope="col">@L["Wt_ColState"]</th>
                            <th scope="col">@L["Wt_ColFirstBreach"]</th>
                            <th scope="col">@L["Wt_ColCompensation"]</th>
                            <th scope="col">@L["Wt_ColPeriod"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Averaging())
                        {
                            <tr @key="(row.Rule, row.Crew)">
                                <td class="sticky-col">@L.ShiftName(row.Crew)</td>
                                <td><span class="pill law">@WorkingTimeText.LegalReference(row.Rule)</span></td>
                                <td class="mono">@string.Format(Culture, L["Wt_AveragingOf"], WorkingTimeText.WerktaeglichHours(row.AverageWerktaeglichHours), Span(row.Limit))</td>
                                @*
                                    The word carries the state, not the colour: a
                                    planner reading this in print, or with a
                                    colour-vision deficiency, gets the same answer.
                                *@
                                <td><span class="pill @(row.ExceedsAverage ? "late" : "ok")">@L[row.ExceedsAverage ? "Wt_AveragingBreached" : "Wt_AveragingKept"]</span></td>
                                <td>@(row.FirstBreachDate is { } breach ? Format.Date(breach) : L["Wt_AveragingNotBreached"].Value)</td>
                                <td>@(row.CompensationDaysOwed == 0 ? "0" : string.Format(Culture, L["Wt_Days"], row.CompensationDaysOwed))</td>
                                <td>
                                    @string.Format(Culture, L["Wt_Range"], Format.Date(row.WindowStart), Format.Date(row.WindowEnd))
                                    <span class="muted"> · @string.Format(Culture, L["Wt_AveragingWerktage"], row.Werktage)</span>
                                    <span class="muted"> · @L[row.Basis == AveragingBasis.MaterialisedRange ? "Wt_AveragingMeasured" : "Wt_AveragingProjected"]</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </TableScroll>
        }
    </section>

    <div class="wt-layout">
        <section class="card">
            <div class="card-head"><h2>@L["WorkingTime_Catalog"]</h2></div>
            <div class="card-body">
                <dl class="rule-list">
                    @foreach (var rule in WorkingTimeRules.Catalog)
                    {
                        <div class="rule">
                            <dt><span class="pill law">@rule.LegalReference</span> @L[$"Rule_{rule.Id}_Title"]</dt>
                            <dd>@L[$"Rule_{rule.Id}_Text"]</dd>
                        </div>
                    }
                </dl>
            </div>
        </section>

        <section class="card no-pad">
            <div class="card-head pad">
                <h2>@string.Format(L["WorkingTime_Holidays"], _holidayYear)</h2>
                <span class="muted gantt-legend-note">@L["WorkingTime_HolidaysNote"]</span>
            </div>
            <TableScroll Label="@string.Format(L["WorkingTime_Holidays"], _holidayYear)">
                <table class="data-table">
                    <caption class="sr-only">@string.Format(L["WorkingTime_Holidays"], _holidayYear)</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="sticky-col">@L["Common_Date"]</th>
                            <th scope="col">@L["Field_Name"]</th>
                            <th scope="col">@L["Field_Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var holiday in _holidays)
                        {
                            <tr @key="holiday.Key">
                                <td class="mono sticky-col">@Format.DayMonth(holiday.Date)</td>
                                <td>@L[$"Holiday_{holiday.Key}"]</td>
                                <td><span class="pill @(holiday.Scope == HolidayScope.Nationwide ? "ok" : "off")">@L[$"HolidayScope_{holiday.Scope}"]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </TableScroll>
        </section>
    </div>

    <section class="card no-pad">
        <div class="card-head pad">
            <div>
                <h2>@L["WorkingTime_Absences"]</h2>
                <p class="page-sub">@L["WorkingTime_AbsencesNote"]</p>
            </div>
            <AuthorizeView Policy="@Permissions.ManageAbsences">
                <button class="btn btn-outline" @onclick="NewAbsence">
                    <span class="btn-plus">+</span> @L["WorkingTime_AddAbsence"]
                </button>
            </AuthorizeView>
        </div>
        @if (_absences.Count == 0)
        {
            <div class="empty-state small"><p>@L["WorkingTime_AbsencesEmpty"]</p></div>
        }
        else
        {
            <TableScroll Label="@L["WorkingTime_Absences"]">
                <table class="data-table">
                    <caption class="sr-only">@L["WorkingTime_Absences"]</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="sticky-col">@L["Field_WorkCenter"]</th>
                            <th scope="col">@L["WorkingTime_AbsenceFrom"]</th>
                            <th scope="col">@L["WorkingTime_AbsenceTo"]</th>
                            <th scope="col">@L["WorkingTime_AbsenceKind"]</th>
                            <th scope="col">@L["WorkingTime_AbsenceLabel"]</th>
                            <th scope="col" class="actions-col">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var absence in _absences)
                        {
                            <tr @key="absence.Id">
                                <td class="sticky-col"><span class="mono">@absence.WorkCenter?.Code</span> <span class="muted">@absence.WorkCenter?.Name</span></td>
                                <td>@Format.DateTime(absence.Start)</td>
                                <td>@Format.DateTime(absence.End)</td>
                                <td>@L[$"Absence_{absence.Kind}"]</td>
                                <td>@absence.Label</td>
                                <td class="actions-col">
                                    <AuthorizeView Policy="@Permissions.ManageAbsences">
                                        <button class="icon-btn danger" aria-label="@L["Common_Delete"]" title="@L["Common_Delete"]" @onclick="() => RemoveAbsenceAsync(absence.Id)">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                        </button>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </TableScroll>
        }
    </section>
}

<Modal @bind-Visible="_showAbsence" Title="@L["WorkingTime_AddAbsence"]">
    <ChildContent>
        <div class="form-grid">
            <label class="field wide">
                <span>@L["Field_WorkCenter"]</span>
                <select id="abs-center" class="input" @bind="_newAbsence.WorkCenterId">
                    <option value="0">—</option>
                    @foreach (var center in _centers)
                    {
                        <option value="@center.Id">@center.Code — @center.Name</option>
                    }
                </select>
                @if (_absenceErrors.TryGetValue("WorkCenterId", out var centerError))
                {
                    <span class="field-error">@centerError</span>
                }
            </label>
            <label class="field">
                <span>@L["WorkingTime_AbsenceFrom"]</span>
                <input id="abs-from" class="input @(_absenceErrors.ContainsKey("Start") ? "error" : null)" type="datetime-local"
                       max="@LocalStamp(_newAbsence.End)" @bind="_newAbsence.Start" />
                @if (_absenceErrors.TryGetValue("Start", out var startError))
                {
                    <span class="field-error">@startError</span>
                }
            </label>
            <label class="field">
                <span>@L["WorkingTime_AbsenceTo"]</span>
                <input id="abs-to" class="input @(_absenceErrors.ContainsKey("End") ? "error" : null)" type="datetime-local"
                       min="@LocalStamp(_newAbsence.Start)" @bind="_newAbsence.End" />
                @if (_absenceErrors.TryGetValue("End", out var endError))
                {
                    <span class="field-error">@endError</span>
                }
            </label>
            <label class="field">
                <span>@L["WorkingTime_AbsenceKind"]</span>
                <select class="input" @bind="_newAbsence.Kind">
                    @foreach (var kind in Enum.GetValues<AbsenceKind>())
                    {
                        <option value="@kind">@L[$"Absence_{kind}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>@L["WorkingTime_AbsenceLabel"]</span>
                <input id="abs-label" class="input" maxlength="80" @bind="_newAbsence.Label" @bind:event="oninput" />
            </label>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showAbsence = false">@L["Common_Cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveAbsenceAsync" disabled="@_saving">@L["Common_Save"]</button>
    </Footer>
</Modal>

@code {
    /// <summary>
    /// How far the preview is materialised. Twenty-six weeks is the longer of the
    /// two reference periods § 3 sentence 2 offers, so whichever the plant picked,
    /// the werktäglich average below is <i>measured</i> over a real calendar —
    /// holidays included — instead of being projected from the repeating week.
    /// </summary>
    private const int PreviewWeeks = 26;

    /// <summary>
    /// Whether the preview extends the pattern beyond the days it declares.
    /// A plant that also runs Saturdays or Sundays is a different plan under
    /// § 3 and § 11, and neither preset can express it; asking the question here
    /// costs nothing and is the only way to see what those two sections do.
    /// </summary>
    private enum PreviewDays
    {
        /// <summary>The pattern exactly as it is stored.</summary>
        AsDefined,

        /// <summary>Saturday added. Still a Werktag, so it enters the § 3 divisor too.</summary>
        WithSaturday,

        /// <summary>Saturday and Sunday added. Sunday hours count towards the average without adding a Werktag to divide by.</summary>
        WithSunday
    }

    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;
    private readonly Dictionary<string, string> _formErrors = new();

    private PlantSettings _form = new();
    private List<WorkCenter> _centers = [];
    private List<WorkCenterAbsence> _absences = [];

    private string _previewKey = ShiftPatterns.OneShift.Key;
    private PreviewDays _previewDays = PreviewDays.AsDefined;
    private WorkingTimeline? _preview;
    private IReadOnlyList<PublicHoliday> _holidays = [];
    private int _holidayYear = 2026;

    private string _ruleAnnouncement = "";
    private string _resultAnnouncement = "";
    private RestExceptionSector _lastSector;
    private bool _lastSundayWork;

    private bool _showAbsence;
    private WorkCenterAbsence _newAbsence = new();
    private readonly Dictionary<string, string> _absenceErrors = new();

    private static CultureInfo Culture => CultureInfo.CurrentUICulture;

    protected override async Task OnInitializedAsync()
    {
        _form = (await Settings.GetAsync()).Clone();
        _centers = await Centers.GetAllAsync();
        _absences = await Centers.GetAbsencesAsync();
        _previewKey = _centers.FirstOrDefault(c => c.ShiftPatternKey != ShiftPatterns.Continuous.Key)?.ShiftPatternKey ?? ShiftPatterns.OneShift.Key;
        _lastSector = _form.RestExceptionSector;
        _lastSundayWork = _form.SundayWorkAllowed;
        Recompute();
        _loading = false;
    }

    /// <summary>Re-derives the preview and the holiday table from the form as it stands — live, before saving.</summary>
    private void Recompute()
    {
        _saved = false;

        // Declaring no § 5 (2) sector is declaring the § 5 (1) rest: the shortened
        // value stops being on offer, so the form stops holding it. Not silent —
        // the note under the control and the live region both say so.
        if (_form.RestExceptionSector == RestExceptionSector.None)
            _form.MinimumRestHours = 11;

        AnnounceReveals();

        _formErrors.Clear();
        foreach (var issue in PlantSettingsValidator.Validate(_form))
            _formErrors.TryAdd(issue.Field, L[issue.MessageKey, issue.Arguments]);
        if (_formErrors.Count > 0)
            return;

        var rules = _form.ToRules();
        // The pattern repeats weekly, but § 3 sentence 2, § 6 (2) and § 11 are
        // duties about a period, and a period only exists on a calendar. The
        // range starts on the first Monday of the year the holiday table shows,
        // so both halves of the page talk about the same year and the render
        // stays deterministic.
        var weekStart = FirstMondayOf(_holidayYear);
        _preview = WorkingTimelineBuilder.Build(pattern: PreviewPattern(), rules, [], weekStart, weekStart.AddDays(PreviewWeeks * 7));
        _holidays = GermanHolidays.ForYear(_holidayYear, rules.State, rules.IncludePartialHolidays);
        _resultAnnouncement = Announce(_preview);
    }

    /// <summary>The Monday on or after 1 January — where a weekly pattern's first full week begins.</summary>
    private static DateTime FirstMondayOf(int year)
    {
        var first = new DateTime(year, 1, 1);
        return first.AddDays((8 - (int)first.DayOfWeek) % 7);
    }

    /// <summary>
    /// The preset, with the extra operating days the preview asks about folded
    /// into every shift. A continuous pattern has no shifts to extend.
    /// </summary>
    private ShiftPattern PreviewPattern()
    {
        var pattern = ShiftPatterns.ByKey(_previewKey) ?? ShiftPatterns.OneShift;
        var extra = _previewDays switch
        {
            PreviewDays.WithSaturday => WorkDays.Saturday,
            PreviewDays.WithSunday => WorkDays.Saturday | WorkDays.Sunday,
            _ => WorkDays.None
        };

        return extra == WorkDays.None || pattern.IsContinuous
            ? pattern
            : pattern with { Shifts = pattern.Shifts.Select(shift => shift with { Days = shift.Days | extra }).ToList() };
    }

    /// <summary>
    /// A control that appears without a word is a control a screen-reader user
    /// never learns about. Both of the conditional ones here say what they are
    /// for at the moment the condition that reveals them changes.
    /// </summary>
    private void AnnounceReveals()
    {
        var announcements = new List<string>();

        if (_form.RestExceptionSector != _lastSector)
        {
            _lastSector = _form.RestExceptionSector;
            announcements.Add(_lastSector == RestExceptionSector.None ? L["Wt_RestNoSector"] : L["Wt_RestSectorOpened"]);
        }

        if (_form.SundayWorkAllowed != _lastSundayWork)
        {
            _lastSundayWork = _form.SundayWorkAllowed;
            if (_lastSundayWork)
                announcements.Add(L["Wt_SundayRotationOpened"]);
        }

        _ruleAnnouncement = string.Join(" ", announcements);
    }

    /// <summary>
    /// The § 11 (1) line: the count, and what the count means. An unconstrained
    /// pattern staffs nobody, so the count would be a number about no one — there
    /// the sentence is all there is to say.
    /// </summary>
    private string SundaySentence(WorkingTimeline preview)
    {
        var state = L[$"Wt_SundayStatus_{preview.SundayRest}"].Value;
        if (preview.SundayRest == SundayRestStatus.NotApplicable)
            return state;

        var count = string.Format(
            Culture,
            L["Wt_FreeSundays"],
            preview.FreeSundays(_holidayYear),
            _holidayYear,
            preview.Rules.MinimumFreeSundaysPerYear);
        return $"{count} {state}";
    }

    /// <summary>The per-crew averaging results, crew first so a plant reads its own rows together.</summary>
    private IReadOnlyList<AveragingResult> Averaging() =>
        _preview is null
            ? []
            : _preview.Compliance.Averaging.OrderBy(a => a.Crew, StringComparer.Ordinal).ThenBy(a => a.Rule).ToList();

    /// <summary>
    /// One sentence for the live region. The table is the record; what a
    /// screen-reader user needs after changing a control is the worst number and
    /// whether it is still lawful.
    /// </summary>
    private string Announce(WorkingTimeline preview)
    {
        if (preview.Capacity is WeekCapacity.Closed)
            return L["Wt_WeekClosed"];

        var worst = Averaging().OrderByDescending(a => a.AverageWerktaeglichHours).FirstOrDefault();
        if (worst is null)
            return L["Wt_AveragingNone"];

        return string.Format(
            Culture,
            L["Wt_AnnounceAveraging"],
            WorkingTimeText.WerktaeglichHours(worst.AverageWerktaeglichHours),
            L.ShiftName(worst.Crew),
            L[worst.ExceedsAverage ? "Wt_AveragingBreached" : "Wt_AveragingKept"]);
    }

    /// <summary>
    /// Green where § 11 (1) is kept — whether because nobody works a Sunday or
    /// because the declared rota leaves enough free — and amber where it is not.
    /// The sentence beside the dot says which of the two it is; the colour only
    /// repeats whether the plan is lawful.
    /// </summary>
    private string SundayTone => _preview?.SundayRest switch
    {
        SundayRestStatus.Intact or SundayRestStatus.Rotated => "tone-good",
        SundayRestStatus.Breach => "tone-warning",
        _ => "tone-info"
    };

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var result = await Settings.SaveAsync(_form);
            if (result.IsSuccess)
            {
                _saved = true;
                return;
            }

            foreach (var issue in result.ValidationIssues ?? [])
                _formErrors.TryAdd(issue.Field, L[issue.MessageKey, issue.Arguments]);
            if (_formErrors.Count == 0)
                _error = L["Error_SaveFailed"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Saving plant settings failed");
            _error = L["Error_SaveFailed"];
        }
        finally
        {
            _saving = false;
        }
    }

    private void NewAbsence()
    {
        var today = DateTime.Today;
        _newAbsence = new WorkCenterAbsence
        {
            WorkCenterId = _centers.FirstOrDefault()?.Id ?? 0,
            Start = today.AddDays(1).AddHours(7),
            End = today.AddDays(1).AddHours(15),
            Kind = AbsenceKind.Maintenance
        };
        _absenceErrors.Clear();
        _showAbsence = true;
    }

    private async Task SaveAbsenceAsync()
    {
        _absenceErrors.Clear();
        _error = null;
        _saving = true;
        try
        {
            var result = await Centers.AddAbsenceAsync(_newAbsence);
            if (result.IsSuccess)
            {
                _showAbsence = false;
                _absences = await Centers.GetAbsencesAsync();
                return;
            }

            foreach (var issue in result.ValidationIssues ?? [])
                _absenceErrors.TryAdd(issue.Field, L[issue.MessageKey, issue.Arguments]);
            if (_absenceErrors.Count == 0)
                _error = L["Error_SaveFailed"];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveAbsenceAsync(int id)
    {
        _error = null;
        var result = await Centers.RemoveAbsenceAsync(id);
        if (!result.IsSuccess)
            _error = L["Error_ActionFailed"];
        _absences = await Centers.GetAbsencesAsync();
    }

    private static string Hours(long seconds) => Format.Hours(seconds / 60m);

    /// <summary>
    /// The same cut on several days reads as one line — "early, Mon–Fri" — rather
    /// than five. Grouped by rule, shift and the values before/after.
    /// </summary>
    private static IEnumerable<(RuleApplication Sample, IReadOnlyList<DayOfWeek> Days)> GroupedApplications(WorkingTimeline timeline) =>
        timeline.Applications
            .GroupBy(a => (a.Rule, a.ShiftKey, a.Before, a.After))
            .Select(g => (g.First(), (IReadOnlyList<DayOfWeek>)g.Select(a => a.Day).Distinct().OrderBy(Order).ToList()))
            .OrderBy(g => Order(g.Item2[0]))
            .ThenBy(g => g.Item1.Rule);

    private static int Order(DayOfWeek day) => day == DayOfWeek.Sunday ? 7 : (int)day;

    /// <summary>
    /// § 11's two windows are deadlines, not durations: the statute says two
    /// weeks and eight weeks, and the ordinary duration formatter would render
    /// them as 336 h and 1 344 h. Every other rule's values really are durations.
    /// </summary>
    private string Describe(RuleApplication application, IReadOnlyList<DayOfWeek> days)
    {
        string after = application.Rule == WorkingTimeRuleId.ReplacementRestDay
            ? L.Deadline(application.After)
            : Span(application.After);

        return L[$"Applied_{application.Rule}", L.ShiftName(application.ShiftKey), DayRange(days), Span(application.Before), after];
    }

    /// <summary>"Monday" / "Mon–Fri" / "Mon, Wed, Fri" — consecutive days collapse into a range.</summary>
    private static string DayRange(IReadOnlyList<DayOfWeek> days)
    {
        var format = Culture.DateTimeFormat;
        if (days.Count == 1)
            return format.GetDayName(days[0]);

        bool consecutive = days.Select(Order).Zip(days.Skip(1).Select(Order), (a, b) => b - a).All(d => d == 1);
        return consecutive
            ? $"{format.GetAbbreviatedDayName(days[0])}–{format.GetAbbreviatedDayName(days[^1])}"
            : string.Join(", ", days.Select(format.GetAbbreviatedDayName));
    }

    /// <summary>
    /// The unit words used to be assembled here, outside both the resources and the
    /// culture. Every duration in the app now goes through the same helper.
    /// </summary>
    private static string Span(TimeSpan value) => Format.Duration(value);

    /// <summary>
    /// `datetime-local` compares its `min`/`max` against an ISO-8601 local stamp, not
    /// against whatever the reader's locale writes — the one place in the app where a
    /// date must deliberately *not* be formatted for a human.
    /// </summary>
    private static string LocalStamp(DateTime moment) =>
        moment.ToString("yyyy-MM-dd\\THH:mm", CultureInfo.InvariantCulture);
}
