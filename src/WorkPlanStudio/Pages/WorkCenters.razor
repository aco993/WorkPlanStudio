@page "/work-centers"
@using WorkPlanStudio.Validation
@inject IStringLocalizer<SharedResource> L
@inject WorkCenterService Centers
@inject CostCenterService CostCenters
@inject NavigationManager Nav
@inject ILogger<WorkCenters> Logger

@using WorkPlanStudio.Services.Forms

<PageTitle>@L["WorkCenters_Title"] · WorkPlan Studio</PageTitle>

<div class="page-head">
    <h1>@L["WorkCenters_Title"]</h1>
    <AuthorizeView Policy="@Permissions.ManageMasterData">
        <button class="btn btn-primary" @onclick="New">
            <span class="btn-plus">+</span> @L["WorkCenters_New"]
        </button>
    </AuthorizeView>
</div>

<ReadOnlyNotice Policy="@Permissions.ManageMasterData" />

@if (_pageError is not null)
{
    <div class="form-banner error" role="alert">@_pageError</div>
}

@if (_loading)
{
    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
}
else if (_centers.Count == 0)
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1" /><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3" /></svg>
        <p>@L["WorkCenters_Empty"]</p>
    </div>
}
else
{
    @*
        Filtering by cost centre is the question a cost centre exists to answer,
        and it was unanswerable while the field was free text. The search box
        covers code and name; the two together are enough for a list of machines,
        which does not grow the way the order list does.
    *@
    <div class="toolbar">
        <div class="search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" aria-label="@L["Md_WorkCenters_SearchPlaceholder"]"
                   placeholder="@L["Md_WorkCenters_SearchPlaceholder"]"
                   value="@_search" @oninput="OnSearch" />
        </div>
        <label class="field inline">
            <span>@L["Field_CostCenter"]</span>
            <select class="input" aria-label="@L["Md_WorkCenters_FilterCostCenter"]" @bind="_costCenterFilter">
                <option value="0">@L["Common_All"]</option>
                @foreach (var costCenter in _costCenters)
                {
                    <option value="@costCenter.Id">@costCenter.Display</option>
                }
            </select>
        </label>
    </div>

    <div class="card no-pad">
        <table class="data-table hover">
            <caption class="sr-only">@L["WorkCenters_Title"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Field_Code"]</th>
                    <th scope="col">@L["Field_Name"]</th>
                    <th scope="col">@L["Field_CostCenter"]</th>
                    <th scope="col" class="num">@L["Field_HourlyRate"]</th>
                    <th scope="col" class="num">@L["Field_Capacity"]</th>
                    <th scope="col">@L["Field_ShiftPattern"]</th>
                    <th scope="col">@L["Field_Status"]</th>
                    <th scope="col" class="num">@L["Field_Operations"]</th>
                    <th scope="col" class="actions-col">@L["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var wc in _page.Slice(Filtered.ToList()))
                {
                    var usage = _usage.GetValueOrDefault(wc.Id);
                    <tr @key="wc.Id">
                        <td><span class="mono">@wc.Code</span></td>
                        <td>@wc.Name</td>
                        <td><span class="muted">@(wc.CostCenter?.Display ?? L["Md_CostCenter_None"].Value)</span></td>
                        <td class="num">@Format.Number(wc.HourlyRate)</td>
                        <td class="num">@wc.ParallelCapacity</td>
                        <td><span class="muted">@ShiftLabel(wc.ShiftPatternKey)</span></td>
                        <td>
                            <span class="pill @(wc.IsActive ? "ok" : "off")">
                                @(wc.IsActive ? L["Common_Active"] : L["Common_Inactive"])
                            </span>
                        </td>
                        <td class="num muted">@usage</td>
                        <td class="actions-col">
                            <AuthorizeView Policy="@Permissions.ManageMasterData">
                                <button class="icon-btn" aria-label="@L["Common_Edit"]" title="@L["Common_Edit"]" @onclick="() => Edit(wc)">
                                    <svg viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                </button>
                                @if (usage > 0)
                                {
                                    <button class="icon-btn" disabled aria-label="@L["WorkCenters_InUse"]" title="@L["WorkCenters_InUse"]">
                                        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                }
                                else
                                {
                                    <button class="icon-btn danger" aria-label="@L["Common_Delete"]" title="@L["Common_Delete"]" @onclick="() => AskDelete(wc)">
                                        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginator Window="_page" OnChanged="StateHasChanged" />
}

<Modal @bind-Visible="_showEditor" Title="@(_editing.Id == 0 ? L["WorkCenters_NewTitle"] : L["WorkCenters_EditTitle"])">
    <ChildContent>
    <MdErrorSummary State="_errors" />
    <div class="form-grid">
        <label class="field">
            <span>@L["Field_Code"]</span>
            <input id="wc-code" class="input @_errors.Style("Code")" maxlength="20"
                   autocomplete="off" spellcheck="false" autocapitalize="characters"
                   aria-invalid="@_errors.Invalid("Code")" aria-describedby="@_errors.DescribedBy("Code")"
                   @bind="_editing.Code" @bind:event="oninput" />
            @if (_errors["Code"] is { } codeError)
            {
                <span id="@_errors.ErrorId("Code")" class="field-error">@codeError</span>
            }
        </label>
        <div class="field">
            <label for="wc-cost-center">@L["Field_CostCenter"]</label>
            <EntityPicker TItem="CostCenter" Id="wc-cost-center"
                          Items="_selectableCostCenters"
                          Value="_editing.CostCenterId"
                          ValueChanged="value => _editing.CostCenterId = value"
                          IdOf="c => c.Id"
                          LabelOf="c => c.Display"
                          IsActive="c => c.IsActive"
                          EmptyLabel="@L["Md_CostCenter_None"]"
                          EmptyHint="@L["Md_CostCenter_NoneDefined"]"
                          CreateLabel="@L["Md_CostCenter_CreateNew"]"
                          OnCreateRequested="CreateCostCenterAsync"
                          Invalid="_errors.Has(nameof(WorkCenter.CostCenterId))"
                          DescribedBy="@_errors.DescribedBy(nameof(WorkCenter.CostCenterId))" />
            @if (_errors[nameof(WorkCenter.CostCenterId)] is { } costCenterError)
            {
                <span id="@_errors.ErrorId(nameof(WorkCenter.CostCenterId))" class="field-error">@costCenterError</span>
            }
        </div>
        <label class="field wide">
            <span>@L["Field_Name"]</span>
            <input id="wc-name" class="input @_errors.Style("Name")" maxlength="100"
                   aria-invalid="@_errors.Invalid("Name")" aria-describedby="@_errors.DescribedBy("Name")"
                   @bind="_editing.Name" @bind:event="oninput" />
            @if (_errors["Name"] is { } nameError)
            {
                <span id="@_errors.ErrorId("Name")" class="field-error">@nameError</span>
            }
        </label>
        <label class="field">
            <span>@L["Field_HourlyRate"]</span>
            @*
                Bound to a nullable. With a non-nullable target Blazor reverts an
                unparsable value - and "empty" is unparsable - so clearing the box
                left the old number in the model and saved it while the screen
                showed nothing. A nullable parses the empty string to null, which
                the save then reports as a missing value.
            *@
            <input id="wc-rate" class="input @_errors.Style("HourlyRate")"
                   type="number" min="0" max="1000000" step="0.01" inputmode="decimal"
                   aria-invalid="@_errors.Invalid("HourlyRate")" aria-describedby="@_errors.DescribedBy("HourlyRate")"
                   @bind="_rate" @bind:event="oninput" />
            @if (_errors["HourlyRate"] is { } rateError)
            {
                <span id="@_errors.ErrorId("HourlyRate")" class="field-error">@rateError</span>
            }
        </label>
        <label class="field">
            <span>@L["Field_Capacity"]</span>
            <input id="wc-capacity" class="input @_errors.Style("ParallelCapacity")"
                   type="number" min="1" max="64" inputmode="numeric"
                   aria-invalid="@_errors.Invalid("ParallelCapacity")" aria-describedby="@_errors.DescribedBy("ParallelCapacity")"
                   @bind="_capacity" @bind:event="oninput" />
            @if (_errors["ParallelCapacity"] is { } capacityError)
            {
                <span id="@_errors.ErrorId("ParallelCapacity")" class="field-error">@capacityError</span>
            }
        </label>
        <label class="field wide">
            <span>@L["Field_ShiftPattern"]</span>
            <select id="wc-shift" class="input @_errors.Style("ShiftPatternKey")"
                    aria-invalid="@_errors.Invalid("ShiftPatternKey")" aria-describedby="@_errors.DescribedBy("ShiftPatternKey")"
                    @bind="_editing.ShiftPatternKey">
                @foreach (var pattern in ShiftPatterns.Presets)
                {
                    <option value="@pattern.Key">@L[$"Shift_{pattern.Key}"]</option>
                }
            </select>
            @if (_errors["ShiftPatternKey"] is { } shiftError)
            {
                <span id="@_errors.ErrorId("ShiftPatternKey")" class="field-error">@shiftError</span>
            }
        </label>
        <label class="field check">
            <input id="wc-active" type="checkbox"
                   aria-invalid="@_errors.Invalid("IsActive")" aria-describedby="@_errors.DescribedBy("IsActive")"
                   @bind="_editing.IsActive" />
            <span>@L["Common_Active"]</span>
        </label>
        @if (_errors["IsActive"] is { } activeError)
        {
            <span id="@_errors.ErrorId("IsActive")" class="field-error">@activeError</span>
        }
    </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showEditor = false">@L["Common_Cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@L["Common_Save"]</button>
    </Footer>
</Modal>

<Modal @bind-Visible="_showDelete" Title="@L["Confirm_DeleteWorkCenterTitle"]">
    <ChildContent>
        <p>@(string.Format(L["Confirm_DeleteWorkCenterBody"], _pendingDelete?.Code))</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showDelete = false">@L["Common_Cancel"]</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">@L["Common_Delete"]</button>
    </Footer>
</Modal>

@code {
    // Every row here carries controls, so the table draws one page of them
    // rather than all of them. See PageWindow for what the measurement was.
    private readonly PageWindow _page = new();
    private bool _loading = true;
    private List<WorkCenter> _centers = new();
    private List<CostCenter> _costCenters = [];
    private List<CostCenter> _selectableCostCenters = [];
    private Dictionary<int, int> _usage = new();
    private string _search = "";
    private int _costCenterFilter;
    private string? _pageError;

    private bool _showEditor;
    private WorkCenter _editing = new() { IsActive = true };
    private decimal? _rate;
    private int? _capacity;
    private readonly FormErrorState _errors = new();
    private bool _saving;

    private bool _showDelete;
    private WorkCenter? _pendingDelete;

    protected override void OnInitialized()
    {
        _errors.Declare("Code", "wc-code");
        _errors.Declare("Name", "wc-name");
        _errors.Declare("HourlyRate", "wc-rate");
        _errors.Declare("ParallelCapacity", "wc-capacity");
        _errors.Declare("ShiftPatternKey", "wc-shift");
        _errors.Declare("IsActive", "wc-active");
        _errors.Declare(nameof(WorkCenter.CostCenterId), "wc-cost-center");
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _centers = await Centers.GetAllAsync();
            _usage = await Centers.GetUsageCountsAsync();
            _costCenters = await CostCenters.GetAllAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<WorkCenter> Filtered => _centers
        .Where(wc => _costCenterFilter == 0 || wc.CostCenterId == _costCenterFilter)
        .Where(wc => string.IsNullOrWhiteSpace(_search)
            || wc.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || wc.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    // The preset label without its clock times, for the table.
    private string ShiftLabel(string key) =>
        L[$"Shift_{key}"].Value.Split(" · ")[0];

    private async Task New()
    {
        _editing = new WorkCenter { IsActive = true, ParallelCapacity = 1 };
        _rate = 0m;
        _capacity = 1;
        _errors.Clear();
        _selectableCostCenters = await CostCenters.GetSelectableAsync();
        _showEditor = true;
    }

    private async Task Edit(WorkCenter wc)
    {
        _editing = new WorkCenter
        {
            Id = wc.Id,
            Code = wc.Code,
            Name = wc.Name,
            CostCenterId = wc.CostCenterId,
            HourlyRate = wc.HourlyRate,
            ParallelCapacity = wc.ParallelCapacity,
            ShiftPatternKey = wc.ShiftPatternKey,
            IsActive = wc.IsActive
        };
        _rate = wc.HourlyRate;
        _capacity = wc.ParallelCapacity;
        _errors.Clear();
        _selectableCostCenters = await CostCenters.GetSelectableAsync(wc.CostCenterId);
        _showEditor = true;
    }

    /// <summary>
    /// Sends the planner to the cost-centre editor without losing this form.
    /// The work centre is a modal over a list, so nothing is navigated away from
    /// that is not already saved; the new tab keeps this page where it is.
    /// </summary>
    private void CreateCostCenterAsync() =>
        Nav.NavigateTo("cost-centers?new=" + Uri.EscapeDataString(_editing.Code));

    private async Task SaveAsync()
    {
        _pageError = null;
        _saving = true;

        try
        {
            // An empty numeric box is now genuinely empty, so it fails validation
            // rather than quietly re-saving the value it used to keep.
            var missing = new List<ValidationIssue>();
            if (_rate is not { } rate)
            {
                rate = 0m;
                missing.Add(new ValidationIssue(nameof(WorkCenter.HourlyRate), "Val_Required"));
            }

            if (_capacity is not { } capacity)
            {
                capacity = 0;
                missing.Add(new ValidationIssue(nameof(WorkCenter.ParallelCapacity), "Val_Required"));
            }

            if (missing.Count > 0)
            {
                _errors.Apply(ApplicationResult<int>.Validation(missing), L);
                return;
            }

            _editing.HourlyRate = rate;
            _editing.ParallelCapacity = capacity;

            var result = await Centers.SaveAsync(_editing);
            if (result.IsSuccess)
            {
                _errors.Clear();
                _showEditor = false;
                await ReloadAsync();
                return;
            }

            _errors.Apply(result, L);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Saving work center {WorkCenterId} failed", _editing.Id);
            _errors.Fail(L["Error_SaveFailed"]);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskDelete(WorkCenter wc)
    {
        _pendingDelete = wc;
        _showDelete = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        _pageError = null;
        if (_pendingDelete is not null)
        {
            var result = await Centers.DeleteAsync(_pendingDelete.Id);
            if (!result.IsSuccess)
                _pageError = result.ValidationIssues is [var issue, ..]
                    ? L[issue.MessageKey, issue.Arguments]
                    : L[result.Status == ApplicationResultStatus.Forbidden ? "Error_Forbidden" : "Error_ActionFailed"];
        }

        _showDelete = false;
        _pendingDelete = null;
        await ReloadAsync();
    }
}
