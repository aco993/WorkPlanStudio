@page "/about"
@inject IStringLocalizer<SharedResource> L
@inject BrowserDatabase Db
@inject NavigationManager Nav
@inject ILogger<About> Logger
@inject IPermissionGuard Guard

<PageTitle>@L["Nav_About"] · WorkPlan Studio</PageTitle>

<div class="page-head">
    <h1>@L["About_Title"]</h1>
</div>

<div class="about-grid">
    @if (_resetError is not null)
    {
        <div class="form-banner error" role="alert">@_resetError</div>
    }
    <section class="card">
        <div class="card-body">
            <p class="lead">@L["About_Intro"]</p>

            <h2 class="about-sub">@L["About_TechTitle"]</h2>
            <ul class="tech-list">
                @foreach (var line in _tech)
                {
                    <li>
                        <svg class="tick" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                        <span>@L[line]</span>
                    </li>
                }
            </ul>

            <div class="tech-badges">
                <span class="tech-badge">.NET 10</span>
                <span class="tech-badge">Blazor WebAssembly</span>
                <span class="tech-badge">EF Core</span>
                <span class="tech-badge">SQLite (WASM)</span>
                <span class="tech-badge">IStringLocalizer</span>
            </div>
        </div>
    </section>

    <div class="about-side">
        <section class="card">
            <div class="card-head"><h2>@L["About_LanguageTitle"]</h2></div>
            <div class="card-body">
                <CultureSelector />
            </div>
        </section>

        <section class="card">
            <div class="card-head"><h2>@L["About_DataTitle"]</h2></div>
            <div class="card-body">
                <p class="muted small-text">@L["About_DataNote"]</p>
                <AuthorizeView Policy="@Permissions.ResetData">
                    <Authorized>
                        <button class="btn btn-outline danger full" @onclick="() => _showReset = true">
                            @L["About_Reset"]
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <ReadOnlyNotice Policy="@Permissions.ResetData" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </section>
    </div>
</div>

<Modal @bind-Visible="_showReset" Title="@L["About_Reset"]">
    <ChildContent>
        <p>@L["About_ResetConfirm"]</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showReset = false">@L["Common_Cancel"]</button>
        <button class="btn btn-danger" @onclick="ResetAsync" disabled="@_resetting">@L["About_Reset"]</button>
    </Footer>
</Modal>

@code {
    private bool _showReset;
    private bool _resetting;
    private string? _resetError;

    private readonly string[] _tech =
    {
        "About_Tech1", "About_Tech2", "About_Tech3", "About_Tech4"
    };

    private async Task ResetAsync()
    {
        _resetting = true;
        _resetError = null;
        try
        {
            // The button is hidden for other personas, but the check that counts is this one.
            if (!await Guard.CanAsync(Permissions.ResetData))
            {
                _resetError = L["Error_Forbidden"];
                return;
            }

            var readiness = await Db.ResetAsync();
            if (!readiness.IsReady)
            {
                _resetError = L["Storage_ResetFailed"];
                return;
            }

            Nav.NavigateTo("", forceLoad: true);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Resetting the demo database failed");
            _resetError = L["Storage_ResetFailed"];
        }
        finally
        {
            _resetting = false;
        }
    }
}
