@page "/schedule"
@using System.Globalization
@using WorkPlanStudio.Services.Chat
@using WorkPlanStudio.Services.Scheduling
@using WorkPlanStudio.WorkingTime
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject IProductionScheduleService Scheduler
@inject ScheduleAssistant Assistant
@inject ScheduleChat Chat
@inject PlantSettingsService PlantSettings
@inject ILogger<Schedule> Logger
@inject IAssistantConfig AssistantConfig
@inject IJSRuntime JS
@inject IOptimalityProver Prover

<PageTitle>@L["Sched_Title"] · WorkPlan Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Sched_Title"]</h1>
        <p class="page-sub">@L["Sched_Subtitle"]</p>
    </div>
    @*
        Cancel is rendered only while a run is in flight, and pressing it destroys
        the element that has focus — so the handler puts focus back on Generate
        rather than letting it fall to <body>. Nothing else on this page moves
        focus: a run finishing must not pull the reader out of whatever they were
        reading while it ran.
    *@
    @*
        Export sits beside Generate because that is where the plan is made, and
        the file is the plan. It carries the parameters of the run on screen, not
        the ones currently in the form — those may have been edited since — and it
        is unavailable while a run is in flight, because the schedule it would
        write is about to be replaced.
    *@
    <div class="head-actions">
        @if (_running)
        {
            <button id="sched-cancel" type="button" class="btn btn-outline" @onclick="CancelRun">@L["Run_Cancel"]</button>
        }
        <ExportMenu Result="@(_result is { HasData: true } ? _result : null)"
                    Parameters="_resultParameters"
                    Disabled="_running"
                    CancellationToken="_lifetimeCancellation.Token" />
        <button id="sched-generate" class="btn btn-primary" @onclick="GenerateAsync"
                disabled="@(_running || _form.ExceedsEvaluationBudget)">
            <svg class="btn-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.5-6.5-1.4 1.4M7.9 16.1l-1.4 1.4m12 0-1.4-1.4M7.9 7.9 6.5 6.5"/><circle cx="12" cy="12" r="3.2"/></svg>
            @(_running ? L["Sched_Generating"] : L["Sched_Generate"])
        </button>
    </div>
</div>

@*
    The result comes first, the parameters that produced it second — in the
    markup as well as on the screen. Measured on a 375x812 phone with the
    parameters first: the KPI row began 934 px down and the Gantt 1,181 px down,
    so a reader on a phone scrolled a screen and a half of a nine-field form
    before reaching anything the form had computed. The page opened on its
    settings.

    The rail could have been reordered with CSS instead, but a layout whose
    visual order and focus order disagree moves the problem rather than fixing
    it: tabbing would leave the header, jump to a form below the fold and come
    back up. Putting the rail after the result in the markup and on the right at
    desktop width keeps reading order, focus order and visual order the same at
    every width, in both directions of the grid. See docs/adr/0026.
*@
<div class="sched-layout">
    <div class="sched-results" aria-busy="@(_running ? "true" : "false")">
        @*
            Regenerating replaces four KPI cards, the chart, the jobs table and the
            narration at once. Nothing announced it: the spinner below only renders
            on the very first run, because _result keeps its previous value while a
            re-run is in flight. This region carries the headline of every run.
        *@
        <p class="sr-only" role="status" aria-live="polite">@_runAnnouncement</p>
        @*
            A determinate bar, because the run has a real denominator: the number of
            multi-start descents. It is deliberately plain about where the work
            happens - the search holds this tab's only thread and gives it back
            between descents, so the page breathes between them rather than
            throughout. Claiming a worker here would be a lie; see ADR 0019.
        *@
        @if (_progress is { } progress)
        {
            <section class="card">
                <div class="card-body">
                    <p id="run-progress-label">@ProgressText(progress)</p>
                    <div class="status-bar" role="progressbar"
                         aria-labelledby="run-progress-label"
                         aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@progress.Percent" aria-valuetext="@ProgressText(progress)">
                        <div class="status-seg" style="width:@Css(progress.Percent)%;background:var(--primary)"></div>
                    </div>
                    <p class="field-hint">@L["Run_SameThreadNote"]</p>
                </div>
            </section>
        }
        @if (_runError is not null)
        {
            <div class="form-banner error" role="alert">@_runError</div>
        }
        @if (_result?.PreparationErrors is { Count: > 0 })
        {
            <section class="form-banner error" role="alert">
                <strong>@L["Sched_RejectedTitle"]</strong>
                <p>@L["Sched_RejectedBody"]</p>
                <ul>
                    @foreach (var issue in _result.PreparationErrors)
                    {
                        <li>
                            <a href="production-orders">@issue.OrderReference</a>
                            @if (issue.OperationNumber is not null)
                            {
                                <span> · @L["Field_OperationNo"] @issue.OperationNumber</span>
                            }
                            <span> — @PreparationError(issue.Code)</span>
                        </li>
                    }
                </ul>
            </section>
        }
        @* The indeterminate spinner is for the wait before a run has started at all
           (the database is still opening). Once the run is under way the bar above
           says the same thing with a number, so the two never show together. *@
        @if (_result is null && _progress is null)
        {
            <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
        }
        else if (_result is { HasData: false })
        {
            <div class="card"><div class="empty-state">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v16"/></svg>
                <p>@L["Sched_Empty"]</p>
            </div></div>
        }
        else if (_result is { HasData: true })
        {
            <div class="stat-grid">
                <div class="stat-card accent-indigo">
                    <div class="stat-top"><span class="stat-value">@Hours(_result.Kpis.MakespanSeconds)</span></div>
                    <div class="stat-label">@L["Sched_KpiMakespan"]</div>
                </div>
                <div class="stat-card accent-green">
                    <div class="stat-top"><span class="stat-value">@Percent(_result.Kpis.OnTimeRate)</span></div>
                    <div class="stat-label">@L["Sched_KpiOnTime"] · @(_result.Kpis.JobCount - _result.Kpis.LateJobCount)/@_result.Kpis.JobCount</div>
                </div>
                <div class="stat-card accent-amber">
                    <div class="stat-top"><span class="stat-value">@Hours(_result.Kpis.TotalTardinessSeconds)</span></div>
                    <div class="stat-label">@L["Sched_KpiTardiness"] · @_result.Kpis.LateJobCount @L["Sched_LateJobs"]</div>
                </div>
                <div class="stat-card accent-slate">
                    <div class="stat-top"><span class="stat-value">@Percent(_result.Kpis.AverageUtilization)</span></div>
                    <div class="stat-label">@L["Sched_KpiUtilization"]</div>
                </div>
            </div>

            @* The chart and its text alternative; see Components/GanttChart.razor. *@
            <GanttChart Result="_result" />

            @*
                The question the KPI cards invite and never answer, given a card of
                its own because it is the strongest thing on the page: the
                heuristic searches the order jobs are dispatched in, the best
                dispatch order is not the best schedule, and an exact solver that
                shares no code with the heuristic settles which is which. It sits
                under the chart, not between it and the KPIs: measured at 375 px,
                that position pushed the Gantt from 463 px to 858 px, undoing the
                result-first layout (ADR 0026). It runs only when
                asked - the solve holds the browser's one thread for up to its
                budget - and the verdict never says "optimal" unless it was proved.
            *@
            <section class="card proof-card" aria-labelledby="proof-title">
                <div class="proof-head">
                    <div class="proof-intro">
                        <h2 id="proof-title">@L["Sched_Proof_Title"]</h2>
                        <p class="proof-lead">@L["Sched_Proof_Lead"]</p>
                    </div>
                    <button type="button" class="btn btn-primary proof-action" @onclick="ProveOptimalAsync"
                            disabled="@(_proving || _running)">
                        @(_proving ? L["Sched_Proof_Busy"] : L["Sched_Proof_Action"])
                    </button>
                </div>
                @if (_proof is { } verdict && verdict.Status != OptimalityProofStatus.NothingToProve)
                {
                    <div class="proof-verdict">
                        <span class="badge @VerdictTone(verdict)">@VerdictLabel(verdict)</span>
                        <dl class="proof-facts">
                            @foreach (var (term, value) in VerdictFacts(verdict))
                            {
                                <div><dt>@term</dt><dd>@value</dd></div>
                            }
                        </dl>
                    </div>
                }
                <p class="proof-answer" role="status" aria-live="polite">@ProofText()</p>
            </section>

            <section class="card no-pad">
                <div class="card-head pad"><h2 id="jobs-table-title">@L["Sched_JobsTable"]</h2></div>
                <TableScroll Label="@L["Sched_JobsTable"]">
                    <table class="data-table jobs-table">
                        <caption class="sr-only">@L["Sched_JobsTable"]</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="sticky-col">@L["Orders_Number"]</th>
                                <th scope="col">@L["Field_PartName"]</th>
                                <th scope="col" class="num">@L["Sched_Target"]</th>
                                <th scope="col" class="num">@L["Sched_Completion"]</th>
                                <th scope="col" class="num">@L["Sched_Lateness"]</th>
                                <th scope="col">@L["Field_Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in _result.Jobs)
                            {
                                <tr @key="j.JobId">
                                    <td class="sticky-col"><span class="color-dot job-color-@j.ColorIndex" aria-hidden="true">@JobLetter(j.ColorIndex)</span><span class="mono">@j.Reference</span></td>
                                    <td>@j.PartName</td>
                                    <td class="num">@DayTime(j.DueSeconds)</td>
                                    <td class="num">@DayTime(j.CompletionSeconds)</td>
                                    <td class="num @(j.IsLate ? "late-text" : null)">@Lateness(j.LatenessSeconds)</td>
                                    <td>
                                        @if (j.IsLate)
                                        {
                                            <span class="pill late">@L["Sched_Late"]</span>
                                        }
                                        else
                                        {
                                            <span class="pill ontime">@L["Sched_OnTime"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </TableScroll>
            </section>

            <section class="card assistant-card">
                <div class="card-head">
                    <div class="assistant-head-left">
                        <h2>@L["Sched_Ai_Title"]</h2>
                        @if (_narration is not null)
                        {
                            <span class="pill @(_narration.Source == NarrationSource.Ai ? "ai" : "off")">@_narration.SourceLabel</span>
                        }
                    </div>
                    <div class="assistant-actions">
                        @if (_aiEnabled)
                        {
                            <button class="btn btn-outline btn-sm" @onclick="AskAiAsync" disabled="@_aiBusy">
                                @(_aiBusy ? L["Sched_Ai_Thinking"] : L["Sched_Ai_AskAi"])
                            </button>
                        }
                        <button class="icon-btn" aria-label="@L["Sched_Ai_Configure"]" title="@L["Sched_Ai_Configure"]" @onclick="OpenAiSettingsAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3m-4.9-7.1-2.1 2.1m-8 8-2.1 2.1m0-12.2 2.1 2.1m8 8 2.1 2.1"/></svg>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <p class="assistant-sub muted">@L["Sched_Ai_Subtitle"]</p>
                    @if (_narration is null)
                    {
                        <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
                    }
                    else
                    {
                        <ul class="assistant-lines">
                            @foreach (var line in _narration.Lines)
                            {
                                <li class="assistant-line @ToneClass(line.Tone)">
                                    <span class="assistant-dot"></span>
                                    <span>@line.Text</span>
                                </li>
                            }
                        </ul>
                        @if (_narration.Note is not null)
                        {
                            <p class="assistant-note">@_narration.Note</p>
                        }
                    }

                    <div class="chat" role="region" aria-labelledby="chat-title">
                        <h3 id="chat-title" class="chat-title">@L["Chat_Title"]</h3>
                        <p class="chat-intro muted">@L["Chat_Intro"]</p>

                        @*
                            Rendered even when empty. A live region has to be in the DOM
                            *before* its content changes: inserting it together with its
                            first two turns is why the first answer of every conversation
                            was never announced, and the second one was.
                        *@
                        <ol class="chat-thread @(Chat.Turns.Count == 0 ? "empty" : null)"
                            aria-live="polite" aria-relevant="additions" aria-label="@L["Chat_Title"]"
                            tabindex="@(Chat.Turns.Count == 0 ? -1 : 0)">
                            @foreach (var turn in Chat.Turns)
                            {
                                <li class="chat-turn @(turn.Role == ChatRole.User ? "user" : "assistant")">
                                    <div class="chat-bubble">@turn.Text</div>
                                    @if (turn.Role == ChatRole.Assistant)
                                    {
                                        <span class="chat-source pill @(turn.Source == NarrationSource.Ai ? "ai" : "off")">@turn.SourceLabel</span>
                                    }
                                    @if (turn.Note is not null)
                                    {
                                        <p class="assistant-note chat-note">@turn.Note</p>
                                    }
                                </li>
                            }
                        </ol>

                        @if (_chatBusy)
                        {
                            <div class="chat-busy" role="status"><span class="spinner" aria-hidden="true"></span><span>@L["Chat_Thinking"]</span></div>
                        }
                        @if (_chatError is not null)
                        {
                            <div class="form-banner error" role="alert">@_chatError</div>
                        }
                        @*
                            A question the page had to drop is an outcome, not a
                            failure — the same distinction a cancelled run gets — so
                            it uses the card's own note style and a status role,
                            not the red banner and an alert.
                        *@
                        @if (_chatNotice is not null)
                        {
                            <p class="assistant-note chat-note" role="status">@_chatNotice</p>
                        }

                        <div class="chat-suggestions">
                            @foreach (var suggestion in Chat.Suggestions)
                            {
                                <button type="button" class="chip" disabled="@(_chatBusy || Chat.IsBusy || _running)" @onclick="() => AskAsync(suggestion)">@suggestion</button>
                            }
                        </div>

                        <form class="chat-input" @onsubmit="SubmitQuestionAsync" @onsubmit:preventDefault>
                            <label class="sr-only" for="chat-question">@L["Chat_Title"]</label>
                            @* maxlength mirrors the service's own limit: the service
                               refuses a longer question anyway, and without this the
                               field accepts a pasted megabyte and re-renders it. *@
                            <input id="chat-question" class="input" autocomplete="off" maxlength="1000" placeholder="@L["Chat_Placeholder"]"
                                   disabled="@(_chatBusy || Chat.IsBusy || _running)" @bind="_question" @bind:event="oninput" />
                            <button type="submit" class="btn btn-primary" disabled="@(_chatBusy || Chat.IsBusy || _running || string.IsNullOrWhiteSpace(_question))">@L["Chat_Send"]</button>
                            @if (Chat.Turns.Count > 0)
                            {
                                @* Chat.IsBusy is the authority: _chatBusy only knows about
                                   the question this page asked. *@
                                <button type="button" class="btn btn-ghost" disabled="@(_chatBusy || Chat.IsBusy)" @onclick="ClearChat">@L["Chat_Clear"]</button>
                            }
                        </form>
                    </div>
                </div>
            </section>
        }
    </div>

    <section class="card param-card">
        <div class="card-head"><h2>@L["Sched_Parameters"]</h2></div>
        <div class="card-body">
            @*
                The hints live outside the <label>, not inside it. Everything inside a
                label becomes part of the control's accessible name, so the
                "equivalent rules" line — which changes after every run — used to
                rename the select each time it was regenerated.
            *@
            <div class="param-grid">
                <div class="field">
                    <label for="sched-rule">@L["Sched_DispatchRule"]</label>
                    <select id="sched-rule" class="input" @bind="_form.DispatchRule"
                            aria-describedby="@(_result is { EquivalentRules.Count: > 0 } ? "sched-rule-hint" : null)">
                        @foreach (var r in Enum.GetValues<DispatchRule>())
                        {
                            <option value="@r">@DispatchLabel(r)</option>
                        }
                    </select>
                    @if (_result is { EquivalentRules.Count: > 0 })
                    {
                        <span id="sched-rule-hint" class="field-hint">
                            @string.Format(
                                L["Sched_RuleEquivalent"],
                                string.Join(", ", _result.EquivalentRules.Select(DispatchLabel)))
                        </span>
                    }
                </div>

                @*
                    The acceptance rule sits beside the dispatch rule because the two
                    together are the strategy: one decides the order the jobs are tried
                    in, the other how the polish spends its budget. Its explanation is
                    a sibling of the <select> rather than a child of a wrapping label,
                    for the reason written above — it changes with the selection, and
                    inside a label it would rename the control each time.
                *@
                <div class="field">
                    <label for="sched-acceptance">@L["Run_Acceptance"]</label>
                    <select id="sched-acceptance" class="input" @bind="_form.LocalSearchAcceptance"
                            aria-describedby="sched-acceptance-hint">
                        @foreach (var a in Enum.GetValues<LocalSearchAcceptance>())
                        {
                            <option value="@a">@AcceptanceLabel(a)</option>
                        }
                    </select>
                    <span id="sched-acceptance-hint" class="field-hint">@AcceptanceHint(_form.LocalSearchAcceptance)</span>
                </div>

                <div class="field">
                    <label for="sched-duerule">@L["Sched_DueRule"]</label>
                    <select id="sched-duerule" class="input" @bind="_form.DueDateRule">
                        @foreach (var r in Enum.GetValues<DueDateRule>())
                        {
                            <option value="@r">@DueLabel(r)</option>
                        }
                    </select>
                </div>

                @switch (_form.DueDateRule)
                {
                    case DueDateRule.TotalWorkContent:
                        <div class="field">
                            <label for="sched-twk">@L["Sched_TwkFactor"]</label>
                            <input id="sched-twk" class="input num" type="number" inputmode="decimal" step="0.1"
                                   min="@Form.TwkMin.ToString(CultureInfo.InvariantCulture)" max="@Form.TwkMax.ToString(CultureInfo.InvariantCulture)"
                                   aria-describedby="sched-twk-hint"
                                   @bind="_form.TwkFlowFactor" @bind:after="_form.Clamp" />
                            <span id="sched-twk-hint" class="field-hint">@Range(Form.TwkMin, Form.TwkMax)</span>
                        </div>
                        break;
                    case DueDateRule.NumberOfOperations:
                        <div class="field">
                            <label for="sched-nop">@L["Sched_NopMinutes"]</label>
                            <input id="sched-nop" class="input num" type="number" inputmode="numeric" min="0" max="@Form.MinutesMax"
                                   aria-describedby="sched-nop-hint" @bind="_form.NopMinutesPerOp" @bind:after="_form.Clamp" />
                            <span id="sched-nop-hint" class="field-hint">@Range(0, Form.MinutesMax)</span>
                        </div>
                        break;
                    case DueDateRule.EqualSlack:
                        <div class="field">
                            <label for="sched-slack">@L["Sched_SlackMinutes"]</label>
                            <input id="sched-slack" class="input num" type="number" inputmode="numeric" min="0" max="@Form.MinutesMax"
                                   aria-describedby="sched-slack-hint" @bind="_form.SlackMinutes" @bind:after="_form.Clamp" />
                            <span id="sched-slack-hint" class="field-hint">@Range(0, Form.MinutesMax)</span>
                        </div>
                        break;
                    default:
                        <div class="field">
                            <label for="sched-con">@L["Sched_ConMinutes"]</label>
                            <input id="sched-con" class="input num" type="number" inputmode="numeric" min="0" max="@Form.MinutesMax"
                                   aria-describedby="sched-con-hint" @bind="_form.ConMinutes" @bind:after="_form.Clamp" />
                            <span id="sched-con-hint" class="field-hint">@Range(0, Form.MinutesMax)</span>
                        </div>
                        break;
                }

                @*
                    These two multiply. Each is inside its own range at 64 and 20 000
                    and their product is 1.28 million candidate schedules, which the
                    engine refuses - and refuses by throwing, which the page could
                    only show as "review the inputs" over a form with eight of them.
                    The pair is therefore validated here, the error belongs to both
                    fields, and Generate is unavailable while it stands.
                *@
                <div class="field">
                    <label for="sched-multistart">@L["Sched_MultiStart"]</label>
                    <input id="sched-multistart" class="input num @BudgetStyle()" type="number" inputmode="numeric" min="1" max="@Form.MultiStartMax"
                           aria-invalid="@BudgetInvalid()" aria-describedby="@BudgetDescribedBy("sched-multistart-hint")"
                           @bind="_form.MultiStartRuns" @bind:after="_form.Clamp" />
                    <span id="sched-multistart-hint" class="field-hint">@Range(1, Form.MultiStartMax)</span>
                </div>
                <div class="field">
                    <label for="sched-localsearch">@L["Sched_LocalSearch"]</label>
                    <input id="sched-localsearch" class="input num @BudgetStyle()" type="number" inputmode="numeric" min="0" max="@Form.LocalSearchMax"
                           aria-invalid="@BudgetInvalid()" aria-describedby="@BudgetDescribedBy("sched-localsearch-hint")"
                           @bind="_form.LocalSearchMaxSteps" @bind:after="_form.Clamp" />
                    <span id="sched-localsearch-hint" class="field-hint">@Range(0, Form.LocalSearchMax)</span>
                </div>
                @if (_form.ExceedsEvaluationBudget)
                {
                    <p id="sched-budget-error" class="field-error" role="alert">
                        @string.Format(
                            L["Run_BudgetExceeded"],
                            Format.Number(_form.TotalEvaluations),
                            Format.Number(SchedulingParameterLimits.MaxTotalEvaluations))
                    </p>
                }
                <label class="field">
                    <span>@L["Sched_Seed"]</span>
                    <input class="input num" type="number" inputmode="numeric" min="0" max="@int.MaxValue"
                           @bind="_form.Seed" @bind:after="_form.Clamp" />
                </label>
            </div>
        </div>
    </section>
</div>

<Modal @bind-Visible="_showAiSettings" Title="@L["Sched_Ai_SettingsTitle"]">
    <ChildContent>
        <div class="form-grid">
            <label class="field check wide">
                <input type="checkbox" @bind="_aiForm.Enabled" />
                <span>@L["Sched_Ai_EnableLabel"]</span>
            </label>
            <label class="field wide">
                <span>@L["Sched_Ai_Provider"]</span>
                <select class="input" @bind="_aiForm.Provider" @bind:after="ProviderChanged">
                    <option value="@AssistantProvider.OpenAiCompatible">@L["Provider_OpenAiCompatible"]</option>
                    <option value="@AssistantProvider.Anthropic">@L["Provider_Anthropic"]</option>
                    <option value="@AssistantProvider.Gemini">@L["Provider_Gemini"]</option>
                </select>
            </label>
            <label class="field wide">
                <span>@L["Sched_Ai_Endpoint"]</span>
                <input class="input" type="url" inputmode="url" spellcheck="false" autocomplete="off" @bind="_aiForm.Endpoint" @bind:event="oninput" />
            </label>
            <label class="field">
                <span>@L["Sched_Ai_Model"]</span>
                <input class="input" @bind="_aiForm.Model" @bind:event="oninput" />
            </label>
            <label class="field">
                <span>@L["Sched_Ai_ApiKey"]</span>
                @* Never populated from storage. An input's value is readable by any
                   script on this origin, and a blank field means "keep the stored
                   key", so the dialog never has to hold the secret at all. *@
                <input class="input" type="password" autocomplete="off" spellcheck="false"
                       placeholder="@(_aiKeyStored ? L["Ai_KeyStored", _aiForm.Provider] : L["Ai_KeyNone"])"
                       @bind="_aiForm.ApiKey" @bind:event="oninput" />
            </label>
            @if (_aiKeyStored)
            {
                <div class="field">
                    <button type="button" class="btn btn-ghost small" @onclick="ForgetAiKeyAsync">@L["Ai_KeyForget"]</button>
                </div>
            }
            @if (_aiKeyNotice is not null)
            {
                <p class="assistant-privacy wide" role="status">@_aiKeyNotice</p>
            }
            @*
                One paragraph. There were two, and they said the same three
                things in different words - browser storage is not a vault,
                not on a shared computer, a deployment needs a proxy - so a
                reader looked for the difference between them.
            *@
            <p class="assistant-privacy wide">@L["Ai_KeyRisk"]</p>
            <p class="assistant-privacy wide">@L["Sched_Ai_CorsNote"]</p>
            @if (_aiSettingsError is not null)
            {
                <div class="form-banner error wide" role="alert">@_aiSettingsError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showAiSettings = false">@L["Common_Cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveAiSettingsAsync">@L["Common_Save"]</button>
    </Footer>
</Modal>

@code {
    private readonly Form _form = new();
    private ScheduleResult? _result;

    /// <summary>
    /// The parameters that produced <see cref="_result"/>, kept apart from the
    /// form because the form goes on being edited after a run. An export names
    /// the settings of the schedule it contains; taking them from the form would
    /// make it name settings that were never run.
    /// </summary>
    private SchedulingParameters _resultParameters = new();

    private bool _running;
    private string? _runError;
    private string? _runAnnouncement;
    private readonly CancellationTokenSource _lifetimeCancellation = new();

    // ----- one run -----

    /// <summary>
    /// Cancels the run in flight without cancelling the page. Linked to the
    /// lifetime source, so navigating away still stops the search — the two
    /// reasons to stop are different, and only one of them has a user behind it.
    /// </summary>
    private CancellationTokenSource? _runCancellation;

    private ScheduleRunProgress? _progress;
    private bool _focusGenerateOnRender;

    // ----- Gantt keyboard state -----

    /// <summary>
    /// The chart's cells lane by lane, ordered by start time — bars and closed
    /// stretches interleaved, because "what happened next on this machine" is the
    /// order a reader expects, not "all the bars, then all the gaps".
    /// </summary>

    // ----- assistant state -----
    private readonly AiForm _aiForm = new();
    private NarrationResult? _narration;
    private bool _aiEnabled;
    private bool _aiBusy;
    private bool _showAiSettings;
    private string? _aiSettingsError;

    // ----- chat state -----
    private string _question = "";
    private bool _chatBusy;
    private string? _chatError;

    /// <summary>Something the reader should know that is not a failure; see the supersede case in <see cref="AskAsync"/>.</summary>
    private string? _chatNotice;
    private bool _scrollChat;

    protected override async Task OnInitializedAsync()
    {
        _aiEnabled = await Assistant.IsAiEnabledAsync();
        await GenerateAsync();
    }

    private async Task GenerateAsync()
    {
        // The button is disabled in both cases; a keyboard activation against a
        // render that has not caught up yet can still arrive here.
        if (_running || _form.ExceedsEvaluationBudget)
            return;

        _runCancellation?.Dispose();
        _runCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCancellation.Token);

        // Held so a cancelled run can put back what was on screen. Everything else
        // the results region reads - the schedule, the chart's lanes, the
        // conversation - is only written on success, so it survives by itself.
        var previousNarration = _narration;

        _running = true;
        _runError = null;
        _narration = null;
        _progress = new ScheduleRunProgress(0, _form.MultiStartRuns, double.PositiveInfinity);
        _runAnnouncement = L["Run_Started"];
        StateHasChanged();

        try
        {
            var parameters = _form.ToParameters();
            _result = await Scheduler.GenerateAsync(
                parameters,
                _form.MinutesPerWorkingDay,
                new InlineProgress<ScheduleRunProgress>(OnProgress),
                _runCancellation.Token);
            _resultParameters = parameters;
            _runAnnouncement = Announcement(_result);

            // Instant, offline, deterministic explanation of the run just produced.
            if (_result.Explanation is not null)
                _narration = await Assistant.ExplainAsync(_result.Explanation);

            await ResetChatAsync(parameters);
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
            // Navigated away mid-run; there is nothing left to render into.
        }
        catch (OperationCanceledException)
        {
            // A cancelled run is an outcome rather than a failure, so it gets the
            // status region and not the error banner. The schedule on screen is the
            // one from before the run, and it was never touched.
            _narration = previousNarration;
            _runAnnouncement = L["Run_Cancelled"];
            _focusGenerateOnRender = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Schedule generation failed");
            _runError = L["Error_ScheduleFailed"];
            _runAnnouncement = L["Error_ScheduleFailed"];
        }
        finally
        {
            _running = false;
            _progress = null;
        }
    }

    /// <summary>
    /// Reported from inside the search, between descents. Rendering happens when
    /// the runner hands the thread back on the next line, which is the only reason
    /// this indicator moves at all.
    /// </summary>
    private void OnProgress(ScheduleRunProgress progress)
    {
        _progress = progress;
        StateHasChanged();
    }

    private void CancelRun() => _runCancellation?.Cancel();

    private async Task AskAiAsync()
    {
        if (_result?.Explanation is null)
            return;

        _aiBusy = true;
        StateHasChanged();
        try
        {
            _narration = await Assistant.ExplainWithAiAsync(_result.Explanation);
        }
        finally
        {
            _aiBusy = false;
        }
    }

    /// <summary>Points the conversation at the run just produced; an old conversation would describe an old schedule.</summary>
    private async Task ResetChatAsync(SchedulingParameters parameters)
    {
        _chatError = null;
        _chatNotice = null;
        if (_result is not { HasData: true, Horizon: { } horizon })
        {
            Chat.Reset(null);
            return;
        }

        var settings = await PlantSettings.GetAsync(_lifetimeCancellation.Token);
        var rules = settings.ToRules();
        var holidays = GermanHolidays.Between(
            DateOnly.FromDateTime(horizon),
            DateOnly.FromDateTime(horizon.AddSeconds(_result.MakespanSeconds)),
            rules.State, rules.IncludePartialHolidays);
        Chat.Reset(new ScheduleChatContext(_result, parameters, rules, holidays));
    }

    private Task SubmitQuestionAsync() => AskAsync(_question);

    private async Task AskAsync(string question)
    {
        // Every one of these is already disabled in the markup; a keyboard
        // activation against a render that has not caught up yet can still
        // arrive here, the same way it can at Generate. _running is the one that
        // matters most: the run about to land will point the conversation at a
        // different schedule, so a question let through now is answered into a
        // thread that is about to be cleared.
        if (_chatBusy || Chat.IsBusy || _running || string.IsNullOrWhiteSpace(question))
            return;

        _chatBusy = true;
        _chatError = null;
        _chatNotice = null;
        _question = "";
        StateHasChanged();
        try
        {
            await Chat.AskAsync(question, _lifetimeCancellation.Token);
            _scrollChat = true;
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
            // Navigated away; there is nothing left to render into.
        }
        catch (OperationCanceledException)
        {
            // Not the page going away: a run landed while this question was in
            // flight and pointed the conversation at the new schedule, so the
            // answer would have described a plan that is no longer on screen.
            // The chat controls are disabled for the length of a run precisely
            // so this is hard to reach, but a question started a moment before
            // Generate is still in flight when the run resets the thread.
            //
            // Say so rather than re-ask. Re-asking would spend a model call the
            // reader did not ask for a second time, and a what-if would re-run
            // the scheduler again seconds after a run just finished; worse, the
            // question may not even mean the same thing about the new plan.
            // Dropping it silently is what made a question asked during a run
            // vanish with no trace at all.
            _chatNotice = L["Chat_SupersededByNewRun"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Chat question failed");
            _chatError = L["Error_ScheduleFailed"];
        }
        finally
        {
            _chatBusy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            // Cancel removes itself from the page, taking the focus with it. This is
            // the one place focus is moved without the reader asking, and it is
            // moved back to the control that replaced the one they pressed.
            if (_focusGenerateOnRender)
            {
                _focusGenerateOnRender = false;
                await JS.InvokeVoidAsync("workplanFocus.byId", "sched-generate");
            }

            if (_scrollChat)
            {
                _scrollChat = false;
                await JS.InvokeVoidAsync("workplanChat.scrollToEnd");
            }
        }
        catch (JSException)
        {
            // every one of these is cosmetic; the content is on the page either way
        }
    }

    private void ClearChat()
    {
        Chat.Reset(Chat.Context);
        _chatError = null;
        _chatNotice = null;
    }

    private string PreparationError(SchedulePreparationErrorCode code) =>
        L[$"Sched_Error_{code}"];

    private bool _aiKeyStored;
    private string? _aiKeyNotice;

    private async Task OpenAiSettingsAsync()
    {
        var settings = await AssistantConfig.LoadAsync(_lifetimeCancellation.Token);
        _aiForm.Enabled = settings.Enabled;
        _aiForm.Provider = settings.Provider;
        _aiForm.PreviousProvider = settings.Provider;
        _aiForm.Endpoint = settings.Endpoint;
        _aiForm.Model = settings.Model;

        // The stored key never re-enters the page; the placeholder says whether
        // one exists, which is all the dialog needs to be usable.
        _aiForm.ApiKey = "";
        _aiKeyStored = await AssistantConfig.HasKeyForAsync(settings.Provider, _lifetimeCancellation.Token);
        _aiKeyNotice = null;
        _aiSettingsError = null;
        _showAiSettings = true;
    }

    private async Task ForgetAiKeyAsync()
    {
        await AssistantConfig.ForgetApiKeyAsync(_lifetimeCancellation.Token);
        _aiForm.ApiKey = "";
        _aiKeyStored = false;
        _aiKeyNotice = L["Ai_KeyForgotten", _aiForm.Provider];
        _aiEnabled = await Assistant.IsAiEnabledAsync(_lifetimeCancellation.Token);
    }

    /// <summary>Switching provider fills in that provider's endpoint and model unless the user typed their own.</summary>
    private async Task ProviderChanged()
    {
        var previous = _aiForm.PreviousProvider;
        if (string.IsNullOrWhiteSpace(_aiForm.Endpoint) || _aiForm.Endpoint == AssistantSettings.DefaultEndpoint(previous))
            _aiForm.Endpoint = AssistantSettings.DefaultEndpoint(_aiForm.Provider);
        if (string.IsNullOrWhiteSpace(_aiForm.Model) || _aiForm.Model == AssistantSettings.DefaultModel(previous))
            _aiForm.Model = AssistantSettings.DefaultModel(_aiForm.Provider);
        _aiForm.PreviousProvider = _aiForm.Provider;

        // Keys are stored per provider, so switching provider switches which key
        // applies. Ask the store rather than guess: a wrong indicator here either
        // hides a key the user has or promises one they do not.
        _aiForm.ApiKey = "";
        _aiKeyNotice = null;
        _aiKeyStored = await AssistantConfig.HasKeyForAsync(_aiForm.Provider, _lifetimeCancellation.Token);
    }

    // ----- proving the schedule optimal -----

    private bool _proving;
    private OptimalityProof? _proof;
    private string? _proofError;

    private async Task ProveOptimalAsync()
    {
        _proving = true;
        _proof = null;
        _proofError = null;
        try
        {
            _proof = await Prover.ProveAsync(_resultParameters ?? _form.ToParameters(), _lifetimeCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // Navigating away, not a failure.
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Proving the schedule optimal failed");
            _proofError = L["Sched_Proof_Failed"];
        }
        finally
        {
            _proving = false;
        }
    }

    /// <summary>
    /// The sentence under the KPI cards. Every branch states what was proved and
    /// what was not — "not proved" is an outcome the search reaches often enough
    /// that hiding it would make the other answers worth less.
    /// </summary>
    private string ProofText()
    {
        if (_proofError is not null)
            return _proofError;
        if (_proof is null)
            return "";

        var proof = _proof;
        return proof.Status switch
        {
            OptimalityProofStatus.NothingToProve => L["Sched_Proof_Nothing"],
            OptimalityProofStatus.TooLarge => L["Sched_Proof_TooLarge", proof.Operations],
            OptimalityProofStatus.ScheduleIsOptimal =>
                L["Sched_Proof_Optimal", Format.Number(proof.Nodes), Format.Seconds(proof.Elapsed)],
            OptimalityProofStatus.BetterScheduleExists =>
                L["Sched_Proof_Better", Format.Number((decimal)(proof.GapPercent ?? 0), 1),
                  Format.Number(proof.Nodes), Format.Seconds(proof.Elapsed)],
            // A failed proof is not one outcome. "We looked at four million
            // schedules and none beat yours" and "we found a better one but
            // cannot say how much better" are different answers, and both used
            // to come out as a percentage above a lower bound that measures the
            // bound's weakness rather than the plan.
            OptimalityProofStatus.NotProvedNoneBetterFound =>
                L["Sched_Proof_NoneBetter", Format.Number(proof.Nodes), Format.Seconds(proof.Elapsed)],
            _ when proof.FoundBetterPercent is { } better =>
                L["Sched_Proof_FoundBetter", Format.Number((decimal)better, 1),
                  Format.Number(proof.Nodes), Format.Seconds(proof.Elapsed)],
            _ => proof.BoundGapPercent is { } bound
                ? L["Sched_Proof_NotProved", Format.Seconds(proof.Elapsed), Format.Number((decimal)bound, 1)]
                : L["Sched_Proof_NotProvedNoBound", Format.Seconds(proof.Elapsed)]
        };
    }

    /// <summary>
    /// The verdict in two or three words, for the badge. The sentence below it
    /// still carries the whole answer; the badge is what a person scanning the
    /// card reads first, so it may only say what the status established.
    /// </summary>
    private string VerdictLabel(OptimalityProof proof) => proof.Status switch
    {
        OptimalityProofStatus.ScheduleIsOptimal => L["Sched_Proof_Verdict_Optimal"],
        OptimalityProofStatus.BetterScheduleExists => L["Sched_Proof_Verdict_Better"],
        OptimalityProofStatus.TooLarge => L["Sched_Proof_Verdict_TooLarge"],
        OptimalityProofStatus.NotProvedNoneBetterFound => L["Sched_Proof_Verdict_NoneBetter"],
        _ when proof.FoundBetterPercent is not null => L["Sched_Proof_Verdict_FoundBetter"],
        _ => L["Sched_Proof_Verdict_NotProved"]
    };

    private static string VerdictTone(OptimalityProof proof) => proof.Status switch
    {
        OptimalityProofStatus.ScheduleIsOptimal => "verdict-proved",
        OptimalityProofStatus.BetterScheduleExists => "verdict-better",
        _ when proof.FoundBetterPercent is not null => "verdict-better",
        _ => "verdict-open"
    };

    /// <summary>
    /// The numbers the verdict rests on, and only those: a gap is shown when an
    /// optimum was proved, a bound when only a bound was, an improvement when
    /// the search found one. A fact the status did not establish is left out
    /// rather than shown as zero.
    /// </summary>
    private IEnumerable<(string Term, string Value)> VerdictFacts(OptimalityProof proof)
    {
        if (proof.Status == OptimalityProofStatus.TooLarge)
        {
            yield return (L["Sched_Proof_Fact_Operations"], Format.Number(proof.Operations));
            yield break;
        }

        if (proof.GapPercent is { } gap)
            yield return (L["Sched_Proof_Fact_Gap"], $"{Format.Number((decimal)gap, 1)} %");
        else if (proof.FoundBetterPercent is { } better)
            yield return (L["Sched_Proof_Fact_Improvement"], $"{Format.Number((decimal)better, 1)} %");
        else if (proof.Status == OptimalityProofStatus.NotProved && proof.BoundGapPercent is { } bound)
            yield return (L["Sched_Proof_Fact_Bound"], $"≤ {Format.Number((decimal)bound, 1)} %");

        yield return (L["Sched_Proof_Fact_Nodes"], Format.Number(proof.Nodes));
        yield return (L["Sched_Proof_Fact_Time"], Format.Seconds(proof.Elapsed));
    }

    private async Task SaveAiSettingsAsync()
    {
        var settings = new AssistantSettings
        {
            Enabled = _aiForm.Enabled,
            Provider = _aiForm.Provider,
            Endpoint = _aiForm.Endpoint.Trim(),
            Model = _aiForm.Model.Trim(),
            ApiKey = _aiForm.ApiKey.Trim()
        };

        // A blank key means "keep the stored one", so completeness is judged
        // without it: the settings are incomplete only when nothing is stored.
        if (settings.Enabled && !(settings.IsUsableApartFromTheKey && (settings.HasApiKey || _aiKeyStored)))
        {
            _aiSettingsError = L["Sched_Ai_InvalidSettings"];
            return;
        }

        await AssistantConfig.SaveAsync(settings, _lifetimeCancellation.Token);
        _aiEnabled = await Assistant.IsAiEnabledAsync(_lifetimeCancellation.Token);
        _showAiSettings = false;
    }

    // ----- display helpers (CSS numbers MUST be invariant; text uses UI culture) -----
    private const long HourSeconds = 3600;
    private const long DaySeconds = 24 * HourSeconds;


    /// <summary>
    /// A, B, C … per job colour. The eight hues were the only thing separating two
    /// jobs on the chart and in the table, which fails for a colour-blind reader, a
    /// greyscale print and a forced-colours theme alike.
    /// </summary>
    private static char JobLetter(int colorIndex) => (char)('A' + colorIndex % 26);

    private string Announcement(ScheduleResult result) =>
        result.HasData
            ? string.Format(
                L["Ui_ScheduleAnnounced"],
                result.Kpis.JobCount - result.Kpis.LateJobCount,
                result.Kpis.JobCount,
                Hours(result.Kpis.MakespanSeconds))
            : L["Sched_Empty"].Value;

    // ----- the evaluation budget, which belongs to two fields at once -----

    private string? BudgetStyle() => _form.ExceedsEvaluationBudget ? "error" : null;

    private string BudgetInvalid() => _form.ExceedsEvaluationBudget ? "true" : "false";

    /// <summary>
    /// Both inputs keep their own range hint and gain the shared message, because
    /// the fault is the pair rather than either value: 64 restarts is legal, 20 000
    /// steps is legal, and marking only one of them would name the wrong culprit.
    /// </summary>
    private string BudgetDescribedBy(string hintId) =>
        _form.ExceedsEvaluationBudget ? hintId + " sched-budget-error" : hintId;

    // ----- the run in flight -----

    private string ProgressText(ScheduleRunProgress progress) =>
        progress.HasBest
            ? string.Format(
                L["Run_Progress"],
                progress.RestartsCompleted,
                progress.TotalRestarts,
                Format.Number((decimal)progress.BestPenalty))
            : L["Run_Preparing"].Value;

    /// <summary>A number destined for a `style` attribute, which is not text and has no culture.</summary>
    private static string Css(int value) => value.ToString(CultureInfo.InvariantCulture);

    private string AcceptanceLabel(LocalSearchAcceptance rule) => rule switch
    {
        LocalSearchAcceptance.FirstImprovement => L["Run_Acceptance_First"],
        LocalSearchAcceptance.BestInsertion => L["Run_Acceptance_Best"],
        LocalSearchAcceptance.SteepestDescent => L["Run_Acceptance_Steepest"],
        _ => rule.ToString()
    };

    private string AcceptanceHint(LocalSearchAcceptance rule) => rule switch
    {
        LocalSearchAcceptance.FirstImprovement => L["Run_Acceptance_FirstHint"],
        LocalSearchAcceptance.BestInsertion => L["Run_Acceptance_BestHint"],
        LocalSearchAcceptance.SteepestDescent => L["Run_Acceptance_SteepestHint"],
        _ => rule.ToString()
    };

    /// <summary>The allowed range, spelled out, so it is not hidden in a `max` attribute.</summary>
    private string Range(double min, double max) =>
        string.Format(L["Ui_Range"], Bound(min), Bound(max));

    private static string Bound(double value) =>
        value == Math.Floor(value)
            ? Format.Number((decimal)value)
            : value.ToString("0.###", CultureInfo.CurrentUICulture);

    /// <summary>

    private string Hours(long seconds) => Format.Hours(seconds / 60m);

    private string DayTime(long seconds)
    {
        if (_result?.Horizon is { } horizon)
            return Format.Stamp(horizon.AddSeconds(seconds));

        long day = seconds / DaySeconds + 1;
        long within = seconds % DaySeconds;
        return $"{L["Sched_DayShort"]}{day} {within / 3600:00}:{within % 3600 / 60:00}";
    }

    private string Lateness(long seconds)
    {
        if (seconds == 0) return Format.Number(0);
        string sign = seconds > 0 ? "+" : "−";
        return sign + Hours(Math.Abs(seconds));
    }

    /// <summary>
    /// Whether a space precedes the sign is the culture's decision, not ours; it used
    /// to be hard-coded to the German convention in both languages.
    /// </summary>
    private static string Percent(double rate) => Format.Percent(rate);

    private static string ToneClass(FindingTone tone) => tone switch
    {
        FindingTone.Good => "tone-good",
        FindingTone.Info => "tone-info",
        _ => "tone-warning"
    };

    private string DispatchLabel(DispatchRule r) => r switch
    {
        DispatchRule.Fifo => L["Sched_Rule_Fifo"],
        DispatchRule.ShortestProcessingTime => L["Sched_Rule_Spt"],
        DispatchRule.LongestProcessingTime => L["Sched_Rule_Lpt"],
        DispatchRule.EarliestDueDate => L["Sched_Rule_Edd"],
        DispatchRule.CriticalRatio => L["Sched_Rule_Cr"],
        DispatchRule.WeightedShortestProcessingTime => L["Sched_Rule_Wspt"],
        _ => r.ToString()
    };

    private string DueLabel(DueDateRule r) => r switch
    {
        DueDateRule.Explicit => L["Sched_Due_Explicit"],
        DueDateRule.TotalWorkContent => L["Sched_Due_Twk"],
        DueDateRule.NumberOfOperations => L["Sched_Due_Nop"],
        DueDateRule.EqualSlack => L["Sched_Due_Slk"],
        DueDateRule.ConstantAllowance => L["Sched_Due_Con"],
        _ => r.ToString()
    };

    /// <summary>Mutable view-model for the parameter form, projected into immutable engine parameters.</summary>
    private sealed class Form
    {
        // The engine throws ArgumentOutOfRangeException for a parameter outside its
        // range, and the page catches every exception into one "review the inputs"
        // banner over a form with seven inputs. `min`/`max` alone do not help: there
        // is no <form>, so the browser never runs constraint validation and a typed
        // 100 binds happily to a field advertising max 64. Clamping on bind means the
        // value the user sees is the value that runs.
        public const double TwkMin = 0.1;
        public const double TwkMax = 100;
        public const int MinutesMax = 5_256_000;    // ten years, the engine's own ceiling
        public const int MultiStartMax = SchedulingParameterLimits.MaxMultiStartRuns;
        public const int LocalSearchMax = SchedulingParameterLimits.MaxLocalSearchSteps;

        /// <summary>
        /// The engine's own defaults, so a measurement that changes one of them
        /// reaches a user instead of being shadowed by a literal copied here once.
        /// Every value below that is not an app decision comes from this instance.
        /// </summary>
        private static readonly SchedulingParameters Defaults = new();

        public DispatchRule DispatchRule { get; set; } = Defaults.DispatchRule;

        /// <summary>
        /// The one deliberate departure from the library default
        /// (<see cref="DueDateRule.TotalWorkContent"/>). A production order carries
        /// the date the customer was promised, so the app does not need to invent
        /// one; the other four rules stay available for a what-if.
        /// </summary>
        public DueDateRule DueDateRule { get; set; } = DueDateRule.Explicit;

        public double TwkFlowFactor { get; set; } = Defaults.TwkFlowFactor;
        public int NopMinutesPerOp { get; set; } = ToMinutes(Defaults.NopSecondsPerOp);
        public int SlackMinutes { get; set; } = ToMinutes(Defaults.SlackSeconds);
        public int ConMinutes { get; set; } = ToMinutes(Defaults.ConstantAllowanceSeconds);
        public int MultiStartRuns { get; set; } = Defaults.MultiStartRuns;
        public int LocalSearchMaxSteps { get; set; } = Defaults.LocalSearchMaxSteps;
        public LocalSearchAcceptance LocalSearchAcceptance { get; set; } = Defaults.LocalSearchAcceptance;
        public int Seed { get; set; } = Defaults.Seed;

        /// <summary>
        /// Working minutes per calendar day. Display only: it maps work-time onto
        /// days for the chart and has no effect on capacity or on the schedule.
        /// <para>
        /// It used to live on <c>SchedulingParameters</c>, which is a library that
        /// claims to have no UI concerns, and it is an app value now. It is kept off
        /// the form on purpose: nothing the page renders reads it yet, and a control
        /// that visibly changes nothing is worse than no control.
        /// </para>
        /// </summary>
        public int MinutesPerWorkingDay { get; set; } = IProductionScheduleService.DefaultMinutesPerWorkingDay;

        /// <summary>Candidate schedules this run would build: the product is what costs.</summary>
        public long TotalEvaluations => (long)MultiStartRuns * LocalSearchMaxSteps;

        /// <summary>
        /// Whether the pair exceeds what the engine accepts. Not folded into
        /// <see cref="Clamp"/> on purpose: clamping is right for a single field
        /// whose own limit the user can read off the hint beside it, and wrong here,
        /// where silently rewriting one of two legal numbers would hide which pair
        /// was refused and why.
        /// </summary>
        public bool ExceedsEvaluationBudget => TotalEvaluations > SchedulingParameterLimits.MaxTotalEvaluations;

        /// <summary>Pulls every parameter back inside the range its own field advertises.</summary>
        public void Clamp()
        {
            TwkFlowFactor = Math.Clamp(TwkFlowFactor, TwkMin, TwkMax);
            NopMinutesPerOp = Math.Clamp(NopMinutesPerOp, 0, MinutesMax);
            SlackMinutes = Math.Clamp(SlackMinutes, 0, MinutesMax);
            ConMinutes = Math.Clamp(ConMinutes, 0, MinutesMax);
            MultiStartRuns = Math.Clamp(MultiStartRuns, 1, MultiStartMax);
            LocalSearchMaxSteps = Math.Clamp(LocalSearchMaxSteps, 0, LocalSearchMax);
            Seed = Math.Max(0, Seed);
        }

        public SchedulingParameters ToParameters() => new()
        {
            DispatchRule = DispatchRule,
            DueDateRule = DueDateRule,
            TwkFlowFactor = TwkFlowFactor,
            NopSecondsPerOp = NopMinutesPerOp * 60L,
            SlackSeconds = SlackMinutes * 60L,
            ConstantAllowanceSeconds = ConMinutes * 60L,
            MultiStartRuns = MultiStartRuns,
            LocalSearchMaxSteps = LocalSearchMaxSteps,
            LocalSearchAcceptance = LocalSearchAcceptance,
            Seed = Seed
        };

        private static int ToMinutes(long seconds) => (int)(seconds / 60);
    }

    /// <summary>Mutable view-model for the AI assistant settings dialog.</summary>
    private sealed class AiForm
    {
        public bool Enabled { get; set; }
        public AssistantProvider Provider { get; set; } = AssistantProvider.OpenAiCompatible;
        public AssistantProvider PreviousProvider { get; set; } = AssistantProvider.OpenAiCompatible;
        public string Endpoint { get; set; } = AssistantSettings.DefaultEndpoint(AssistantProvider.OpenAiCompatible);
        public string Model { get; set; } = AssistantSettings.DefaultModel(AssistantProvider.OpenAiCompatible);
        public string ApiKey { get; set; } = "";
    }

    public void Dispose()
    {
        _lifetimeCancellation.Cancel();
        _lifetimeCancellation.Dispose();
        _runCancellation?.Dispose();
    }
}
