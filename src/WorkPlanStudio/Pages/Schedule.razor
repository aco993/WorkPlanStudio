    /// <summary>The allowed range, spelled out, so it is not hidden in a `max` attribute.</summary>
    private string Range(double min, double max) =>
        string.Format(L["Ui_Range"], Bound(min), Bound(max));

    private static string Bound(double value) =>
        value == Math.Floor(value)
            ? Format.Number((decimal)value)
            : value.ToString("0.###", CultureInfo.CurrentUICulture);

    /// <summary>
    /// Axis ticks in seconds from the horizon: every 6 h for a short schedule,
    /// every midnight for up to a fortnight, every few days beyond. Anchored to
    /// real midnights when a horizon is known.
    /// </summary>
    private IEnumerable<long> AxisTicks()
    {
        long makespan = _result?.MakespanSeconds ?? 0;
        if (makespan <= 0)
            yield break;

        long step = makespan <= 36 * HourSeconds ? 6 * HourSeconds
                  : makespan <= 15 * DaySeconds ? DaySeconds
                  : DaySeconds * (long)Math.Ceiling(makespan / (14.0 * DaySeconds));

        long first = step;
        if (_result?.Horizon is { } horizon)
        {
            // Snap to the next boundary of `step` in wall-clock time.
            long offset = (long)horizon.TimeOfDay.TotalSeconds;
            first = step - offset % step;
            if (first == step && offset != 0) first = step - offset;
            if (first <= 0) first += step;
        }

        for (long t = first; t < makespan; t += step)
            yield return t;
    }

    private string AxisLabel(long seconds)
    {
        if (_result?.Horizon is not { } horizon)
            return Hours(seconds);

        var moment = horizon.AddSeconds(seconds);
        return moment.TimeOfDay == TimeSpan.Zero ? Format.DayMonth(moment) : Format.Time(moment);
    }

    private string Hours(long seconds) => Format.Hours(seconds / 60m);

    private string DayTime(long seconds)
    {
        if (_result?.Horizon is { } horizon)
            return Format.Stamp(horizon.AddSeconds(seconds));

        long day = seconds / DaySeconds + 1;
        long within = seconds % DaySeconds;
        return $"{L["Sched_DayShort"]}{day} {within / 3600:00}:{within % 3600 / 60:00}";
    }

    private string Lateness(long seconds)
    {
        if (seconds == 0) return Format.Number(0);
        string sign = seconds > 0 ? "+" : "−";
        return sign + Hours(Math.Abs(seconds));
    }

    /// <summary>
    /// Whether a space precedes the sign is the culture's decision, not ours; it used
    /// to be hard-coded to the German convention in both languages.
    /// </summary>
    private static string Percent(double rate) => Format.Percent(rate);

    private static string ToneClass(FindingTone tone) => tone switch
    {
        FindingTone.Good => "tone-good",
        FindingTone.Info => "tone-info",
        _ => "tone-warning"
    };

    private string DispatchLabel(DispatchRule r) => r switch
    {
        DispatchRule.Fifo => L["Sched_Rule_Fifo"],
        DispatchRule.ShortestProcessingTime => L["Sched_Rule_Spt"],
        DispatchRule.LongestProcessingTime => L["Sched_Rule_Lpt"],
        DispatchRule.EarliestDueDate => L["Sched_Rule_Edd"],
        DispatchRule.CriticalRatio => L["Sched_Rule_Cr"],
        DispatchRule.WeightedShortestProcessingTime => L["Sched_Rule_Wspt"],
        _ => r.ToString()
    };

    private string DueLabel(DueDateRule r) => r switch
    {
        DueDateRule.Explicit => L["Sched_Due_Explicit"],
        DueDateRule.TotalWorkContent => L["Sched_Due_Twk"],
        DueDateRule.NumberOfOperations => L["Sched_Due_Nop"],
        DueDateRule.EqualSlack => L["Sched_Due_Slk"],
        DueDateRule.ConstantAllowance => L["Sched_Due_Con"],
        _ => r.ToString()
    };

    /// <summary>Mutable view-model for the parameter form, projected into immutable engine parameters.</summary>
    private sealed class Form
    {
        // The engine throws ArgumentOutOfRangeException for a parameter outside its
        // range, and the page catches every exception into one "review the inputs"
        // banner over a form with seven inputs. `min`/`max` alone do not help: there
        // is no <form>, so the browser never runs constraint validation and a typed
        // 100 binds happily to a field advertising max 64. Clamping on bind means the
        // value the user sees is the value that runs.
        public const double TwkMin = 0.1;
        public const double TwkMax = 100;
        public const int MinutesMax = 5_256_000;    // ten years, the engine's own ceiling
        public const int MultiStartMax = SchedulingParameterLimits.MaxMultiStartRuns;
        public const int LocalSearchMax = SchedulingParameterLimits.MaxLocalSearchSteps;

        /// <summary>
        /// The engine's own defaults, so a measurement that changes one of them
        /// reaches a user instead of being shadowed by a literal copied here once.
        /// Every value below that is not an app decision comes from this instance.
        /// </summary>
        private static readonly SchedulingParameters Defaults = new();

        public DispatchRule DispatchRule { get; set; } = Defaults.DispatchRule;

        /// <summary>
        /// The one deliberate departure from the library default
        /// (<see cref="DueDateRule.TotalWorkContent"/>). A production order carries
        /// the date the customer was promised, so the app does not need to invent
        /// one; the other four rules stay available for a what-if.
        /// </summary>
        public DueDateRule DueDateRule { get; set; } = DueDateRule.Explicit;

        public double TwkFlowFactor { get; set; } = Defaults.TwkFlowFactor;
        public int NopMinutesPerOp { get; set; } = ToMinutes(Defaults.NopSecondsPerOp);
        public int SlackMinutes { get; set; } = ToMinutes(Defaults.SlackSeconds);
        public int ConMinutes { get; set; } = ToMinutes(Defaults.ConstantAllowanceSeconds);
        public int MultiStartRuns { get; set; } = Defaults.MultiStartRuns;
        public int LocalSearchMaxSteps { get; set; } = Defaults.LocalSearchMaxSteps;
        public LocalSearchAcceptance LocalSearchAcceptance { get; set; } = Defaults.LocalSearchAcceptance;
        public int Seed { get; set; } = Defaults.Seed;

        /// <summary>
        /// Working minutes per calendar day. Display only: it maps work-time onto
        /// days for the chart and has no effect on capacity or on the schedule.
        /// <para>
        /// It used to live on <c>SchedulingParameters</c>, which is a library that
        /// claims to have no UI concerns, and it is an app value now. It is kept off
        /// the form on purpose: nothing the page renders reads it yet, and a control
        /// that visibly changes nothing is worse than no control.
        /// </para>
        /// </summary>
        public int MinutesPerWorkingDay { get; set; } = IProductionScheduleService.DefaultMinutesPerWorkingDay;

        /// <summary>Candidate schedules this run would build: the product is what costs.</summary>
        public long TotalEvaluations => (long)MultiStartRuns * LocalSearchMaxSteps;

        /// <summary>
        /// Whether the pair exceeds what the engine accepts. Not folded into
        /// <see cref="Clamp"/> on purpose: clamping is right for a single field
        /// whose own limit the user can read off the hint beside it, and wrong here,
        /// where silently rewriting one of two legal numbers would hide which pair
        /// was refused and why.
        /// </summary>
        public bool ExceedsEvaluationBudget => TotalEvaluations > SchedulingParameterLimits.MaxTotalEvaluations;

        /// <summary>Pulls every parameter back inside the range its own field advertises.</summary>
        public void Clamp()
        {
            TwkFlowFactor = Math.Clamp(TwkFlowFactor, TwkMin, TwkMax);
            NopMinutesPerOp = Math.Clamp(NopMinutesPerOp, 0, MinutesMax);
            SlackMinutes = Math.Clamp(SlackMinutes, 0, MinutesMax);
            ConMinutes = Math.Clamp(ConMinutes, 0, MinutesMax);
            MultiStartRuns = Math.Clamp(MultiStartRuns, 1, MultiStartMax);
            LocalSearchMaxSteps = Math.Clamp(LocalSearchMaxSteps, 0, LocalSearchMax);
            Seed = Math.Max(0, Seed);
        }

        public SchedulingParameters ToParameters() => new()
        {
            DispatchRule = DispatchRule,
            DueDateRule = DueDateRule,
            TwkFlowFactor = TwkFlowFactor,
            NopSecondsPerOp = NopMinutesPerOp * 60L,
            SlackSeconds = SlackMinutes * 60L,
            ConstantAllowanceSeconds = ConMinutes * 60L,
            MultiStartRuns = MultiStartRuns,
            LocalSearchMaxSteps = LocalSearchMaxSteps,
            LocalSearchAcceptance = LocalSearchAcceptance,
            Seed = Seed
        };

        private static int ToMinutes(long seconds) => (int)(seconds / 60);
    }

