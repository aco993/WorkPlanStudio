    /// <summary>A number destined for a `style` attribute, which is not text and has no culture.</summary>
    private static string Css(int value) => value.ToString(CultureInfo.InvariantCulture);

    private string AcceptanceLabel(LocalSearchAcceptance rule) => rule switch
    {
        LocalSearchAcceptance.FirstImprovement => L["Run_Acceptance_First"],
        LocalSearchAcceptance.BestInsertion => L["Run_Acceptance_Best"],
        LocalSearchAcceptance.SteepestDescent => L["Run_Acceptance_Steepest"],
