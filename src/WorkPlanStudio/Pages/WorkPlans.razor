@page "/work-plans"
@inject IStringLocalizer<SharedResource> L
@inject WorkPlanService Plans
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@using Microsoft.AspNetCore.Components.Authorization

@using WorkPlanStudio.Services.Forms

<PageTitle>@L["WorkPlans_Title"] · WorkPlan Studio</PageTitle>

<div class="page-head">
    <h1>@L["WorkPlans_Title"]</h1>
    <AuthorizeView Policy="@Permissions.ManageMasterData">
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("work-plans/new")'>
            <span class="btn-plus">+</span> @L["WorkPlans_New"]
        </button>
    </AuthorizeView>
</div>

@if (_error is not null)
{
    <div class="form-banner error" role="alert">@_error</div>
}

<div class="toolbar">
    <div class="search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" placeholder="@L["WorkPlans_SearchPlaceholder"]"
               value="@_search" @oninput="OnSearch" />
    </div>
    <div class="seg">
        <button class="@(_statusFilter is null ? "active" : null)" @onclick="() => _statusFilter = null">@L["Common_All"]</button>
        @foreach (var s in _statuses)
        {
            <button class="@(_statusFilter == s ? "active" : null)" @onclick="() => _statusFilter = s">@StatusLabel(s)</button>
        }
    </div>
</div>

@if (_loading)
{
    <div class="loading-row" role="status"><span class="spinner" aria-hidden="true"></span><span class="sr-only">@L["Common_Loading"]</span></div>
}
else if (_plans.Count == 0)
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4v2h6V4" /><path d="M9 11h6M9 15h4" /></svg>
        <p>@L["WorkPlans_Empty"]</p>
    </div>
}
else if (!Filtered.Any())
{
    @* This list was the only one that said anything, and it said the same thing
       either way: "no work plans match your search" over a database that simply
       had none in it yet. *@
    <NoMatches />
}
else
{
    <div class="card no-pad">
        <table class="data-table hover">
            <caption class="sr-only">@L["WorkPlans_Title"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Field_PlanNumber"]</th>
                    <th scope="col">@L["Field_PartNumber"]</th>
                    <th scope="col">@L["Field_PartName"]</th>
                    <th scope="col" class="center">@L["Field_RevisionShort"]</th>
                    <th scope="col">@L["Field_Status"]</th>
                    <th scope="col" class="num">@L["Field_Operations"]</th>
                    <th scope="col" class="num">@L["Field_LotSize"]</th>
                    <th scope="col" class="num">@L["Field_TotalTime"]</th>
                    <th scope="col" class="num">@L["Field_TotalCost"]</th>
                    <th scope="col" class="actions-col">@L["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _page.Slice(Filtered.ToList()))
                {
                    <tr class="clickable" @onclick="() => Open(p.Id)">
                        <td><span class="mono">@p.PlanNumber</span></td>
                        <td><span class="mono muted">@p.PartNumber</span></td>
                        <td>@p.PartName</td>
                        <td class="center">@p.Revision</td>
                        <td><StatusBadge Status="p.Status" /></td>
                        <td class="num">@p.OperationCount</td>
                        <td class="num">@Format.Number(p.LotSize)</td>
                        <td class="num">@Format.Hours(p.TotalTimeMinutes)</td>
                        <td class="num">@Format.Euro(p.TotalCost)</td>
                        <td class="actions-col" @onclick:stopPropagation="true">
                            @* "Edit" for a persona that cannot edit is a label that lies about where the button goes. *@
                            <button class="icon-btn" aria-label="@OpenLabel" title="@OpenLabel" @onclick="() => Open(p.Id)">
                                <svg viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                            </button>
                            <AuthorizeView Policy="@Permissions.ManageMasterData">
                                @if (_orderCounts.GetValueOrDefault(p.Id) > 0)
                                {
                                    <button class="icon-btn" disabled aria-label="@L["WorkPlans_InUse"]" title="@L["WorkPlans_InUse"]">
                                        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                }
                                else
                                {
                                    <button class="icon-btn danger" aria-label="@L["Common_Delete"]" title="@L["Common_Delete"]" @onclick="() => AskDelete(p)">
                                        <svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginator Window="_page" OnChanged="StateHasChanged" />
}

<Modal @bind-Visible="_showDelete" Title="@L["Confirm_DeletePlanTitle"]">
    <ChildContent>
        <p>@(string.Format(L["Confirm_DeletePlanBody"], _pendingDelete?.PlanNumber))</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _showDelete = false">@L["Common_Cancel"]</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">@L["Common_Delete"]</button>
    </Footer>
</Modal>

@code {
    // Every row here carries controls, so the table draws one page of them
    // rather than all of them. See PageWindow for what the measurement was.
    private readonly PageWindow _page = new();
    private bool _loading = true;
    private List<WorkPlan> _plans = new();
    private Dictionary<int, int> _orderCounts = new();
    private string _search = "";
    private WorkPlanStatus? _statusFilter;
    private string? _error;

    private bool _showDelete;
    private WorkPlan? _pendingDelete;

    private readonly WorkPlanStatus[] _statuses =
    {
        WorkPlanStatus.Draft, WorkPlanStatus.Released, WorkPlanStatus.Archived
    };

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _plans = await Plans.GetAllAsync();
        _orderCounts = await Plans.GetOrderCountsAsync();
        _loading = false;
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private IEnumerable<WorkPlan> Filtered => _plans
        .Where(p => _statusFilter is null || p.Status == _statusFilter)
        .Where(p => string.IsNullOrWhiteSpace(_search)
            || p.PlanNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || p.PartNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || p.PartName.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private string StatusLabel(WorkPlanStatus s) => s switch
    {
        WorkPlanStatus.Draft => L["Status_Draft"],
        WorkPlanStatus.Released => L["Status_Released"],
        WorkPlanStatus.Archived => L["Status_Archived"],
        _ => s.ToString()
    };


    @* The persona, asked of the authorization pipeline rather than of the
       provider's CurrentRole: that property is the default until the store has
       been read, so a page rendered before the layout got there decides with the
       wrong role. OnParametersSetAsync re-runs when the cascading state changes,
       which is exactly when someone switches persona. *@
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _mayEdit = true;

    private string OpenLabel => _mayEdit ? L["Common_Edit"] : L["Common_View"];

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
            _mayEdit = (await Authorization.AuthorizeAsync(
                (await AuthState).User, Permissions.ManageMasterData)).Succeeded;
    }

    private void Open(int id) => Nav.NavigateTo($"work-plans/{id}");

    private void AskDelete(WorkPlan plan)
    {
        _pendingDelete = plan;
        _showDelete = true;
    }

    /// <summary>
    /// Deletes, and says what happened.
    /// </summary>
    /// <remarks>
    /// The result used to be discarded entirely, so three different outcomes
    /// rendered identically: a Guest saw an unchanged list, a quota failure saw
    /// the row gone and back after a reload, and a plan an order was raised from
    /// replaced the whole application with the error boundary.
    /// </remarks>
    private async Task ConfirmDeleteAsync()
    {
        _error = null;
        if (_pendingDelete is not null)
        {
            var result = await Plans.DeleteAsync(_pendingDelete.Id);
            if (!result.IsSuccess)
                _error = result.ValidationIssues is [var issue, ..]
                    ? L[issue.MessageKey, issue.Arguments]
                    : L[result.Status switch
                    {
                        ApplicationResultStatus.Forbidden => "Error_Forbidden",
                        ApplicationResultStatus.PersistenceFailed => "Error_SaveFailed",
                        ApplicationResultStatus.StorageFull => "Error_StorageFull",
                        ApplicationResultStatus.NotFound => "Error_NotFound",
                        _ => "Error_ActionFailed"
                    }];
        }

        _showDelete = false;
        _pendingDelete = null;
        await ReloadAsync();
    }
}
