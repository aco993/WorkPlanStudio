@inject BrowserDatabase Database
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

@if (_readiness is null)
{
    @*
        The boot screen in index.html is gone the moment this component renders,
        and opening the database - on a first visit creating and seeding it - is
        seconds more work. What the reader used to get for those seconds was a
        bare 28px spinner on an empty page, which looks like the application
        failed rather than like the last step of starting it.

        So this is the boot screen again, same mark and same note slot, and the
        hand-over from the static one is invisible. `boot` already carries the
        full-height centring; `role="status"` keeps the phase announced.
    *@
    <div class="boot" role="status" aria-live="polite">
        <div class="boot-mark" aria-hidden="true">WP</div>
        <span class="spinner" aria-hidden="true"></span>
        <p class="boot-note">@L["Boot_OpeningDatabase"]</p>
    </div>
}
else if (!_readiness.IsReady)
{
    <main class="recovery-shell">
        @*
            The persona switcher, on the one screen that has no layout around it.
            Without it a guest read "export it before resetting", could not see
            the reset (it needs ResetData) and could not become someone who can:
            the screen whose whole job is getting out of a dead end was one.
        *@
        <div class="recovery-bar">
            <PersonaMenu />
        </div>
        <section class="card recovery-card" role="alert">
            <div class="card-head"><h1>@L["Storage_RecoveryTitle"]</h1></div>
            <div class="card-body">
                <p>@RecoveryMessage(_readiness)</p>
                <AuthorizeView Policy="@Permissions.ResetData">
                    <Authorized><p>@L["Storage_RecoveryPreserved"]</p></Authorized>
                    <NotAuthorized><p>@L["Storage_RecoveryPreservedReadOnly"]</p></NotAuthorized>
                </AuthorizeView>

                @if (_actionError is not null)
                {
                    <div class="form-banner error">@_actionError</div>
                }

                <div class="head-actions">
                    @* Exporting is reading your own data, so it stays open to everyone.
                       Importing and resetting replace the whole database; the services
                       refuse a guest either way, and hiding the buttons is the courtesy
                       layer on top of that, not the enforcement. *@
                    <button class="btn btn-outline" @onclick="ExportAsync" disabled="@_busy">@L["Storage_Export"]</button>
                    <AuthorizeView Policy="@Permissions.ResetData">
                        <Authorized>
                            <button class="btn btn-outline" @onclick="ImportAsync" disabled="@_busy">@L["Md_Storage_Import"]</button>
                            @if (!_confirmReset)
                            {
                                <button class="btn btn-danger" @onclick="() => _confirmReset = true" disabled="@_busy">@L["Storage_Reset"]</button>
                            }
                            else
                            {
                                <button class="btn btn-danger" @onclick="ResetAsync" disabled="@_busy">@L["Storage_ResetConfirm"]</button>
                                <button class="btn btn-ghost" @onclick="() => _confirmReset = false" disabled="@_busy">@L["Common_Cancel"]</button>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </section>
    </main>
}
else
{
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
            </Router>
        </ChildContent>
        <ErrorContent Context="exception">
            <main class="recovery-shell">
                <section class="card recovery-card" role="alert">
                    <div class="card-head"><h1>@L["Error_UnexpectedTitle"]</h1></div>
                    <div class="card-body">
                        <p>@L["Error_UnexpectedBody"]</p>
                        <button class="btn btn-primary" @onclick="Recover">@L["Error_Reload"]</button>
                    </div>
                </section>
            </main>
        </ErrorContent>
    </ErrorBoundary>
}

@code {
    private BrowserDatabaseReadiness? _readiness;
    private ErrorBoundary? _errorBoundary;
    private bool _confirmReset;
    private bool _busy;
    private string? _actionError;

    protected override async Task OnInitializedAsync() =>
        _readiness = await Database.EnsureReadyAsync();

    private string RecoveryMessage(BrowserDatabaseReadiness readiness) =>
        L[$"Storage_Failure_{readiness.Failure}", readiness.StoredVersion ?? 0];

    private async Task ExportAsync()
    {
        _busy = true;
        _actionError = null;
        try
        {
            var result = await Database.ExportStoredPayloadAsync();
            if (!result.IsSuccess)
                _actionError = L["Storage_ExportFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reads back the payload a previous export wrote. The recovery screen has
    /// always offered the export; without this the exported file was a dead end,
    /// which made "we never silently overwrite your data" true and useless.
    /// </summary>
    private async Task ImportAsync()
    {
        _busy = true;
        _actionError = null;
        try
        {
            _readiness = await Database.ImportAsync();
            if (!_readiness.IsReady)
                _actionError = L["Md_Storage_ImportFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync()
    {
        _busy = true;
        _actionError = null;
        try
        {
            _readiness = await Database.ResetAsync();
            _confirmReset = false;
            if (!_readiness.IsReady)
                _actionError = L["Storage_ResetFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
