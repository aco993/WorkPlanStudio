@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

@* Blazor intercepts in-page links, so the jump to <main> is done explicitly. *@
<a class="skip-link" href="#main" @onclick="SkipToContentAsync" @onclick:preventDefault="true">@L["Skip_ToContent"]</a>

<div class="app-shell @(_navOpen ? "nav-open" : null)" @onkeydown="OnShellKeyDownAsync">
    @*
        Below 720 px the drawer is hidden with `visibility: hidden`, not only with a
        transform: a transform slides it off-screen but leaves its seven links in the
        tab order, so tabbing from the skip link walked through an invisible menu
        before reaching anything on the page. Visibility is the one property that
        removes them from both the tab order and the accessibility tree, and it does
        so only inside the media query — the sidebar on a desktop stays a normal
        landmark. That is why there is no `inert` here: it would need the viewport.
    *@
    <aside class="sidebar" id="app-nav">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">WP</span>
            <span class="brand-text">
                <span class="brand-name">WorkPlan Studio</span>
                <span class="brand-tag">@L["AppTagline"]</span>
            </span>
        </div>
        <NavMenu />
        <div class="sidebar-footer">@L["Footer_Note"]</div>
    </aside>

    @* Decorative: it duplicates the hamburger and Escape, both of which are reachable. *@
    <div class="scrim" aria-hidden="true" @onclick="CloseNav"></div>

    <div class="content-area">
        <header class="topbar">
            <button class="hamburger" type="button" @ref="_hamburger"
                    aria-label="@L["Ui_NavMenu"]" aria-controls="app-nav" aria-expanded="@(_navOpen ? "true" : "false")"
                    data-testid="nav-toggle" @onclick="ToggleNavAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
            </button>
            <div class="topbar-spacer"></div>
            @* The persona switcher offline, the signed-in account when an API is
               configured. One component decides, so the top bar has one slot. *@
            <AccountMenu />
            <ThemeToggle />
            <CultureSelector />
        </header>

        <main id="main" class="page-body" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _navOpen;
    private ElementReference _hamburger;
    private bool _focusNavOnRender;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private async Task ToggleNavAsync()
    {
        _navOpen = !_navOpen;
        if (_navOpen)
            _focusNavOnRender = true;    // focus follows the drawer in
        else
            await _hamburger.FocusAsync();
    }

    /// <summary>
    /// Opening a drawer that the keyboard cannot reach is the same as not opening it,
    /// so focus moves to the first navigation link. It has to wait for the render that
    /// makes the drawer visible: <c>visibility: hidden</c> refuses focus.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusNavOnRender)
            return;
        _focusNavOnRender = false;
        try
        {
            await JS.InvokeVoidAsync("workplanNav.focusFirst");
        }
        catch (JSException)
        {
            // cosmetic; the drawer is open and reachable by Tab either way
        }
    }

    private async Task OnShellKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _navOpen)
            await ToggleNavAsync();
    }

    private void CloseNav()
    {
        if (!_navOpen) return;
        _navOpen = false;
        StateHasChanged();
    }

    // Collapse the mobile drawer whenever the route changes.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => CloseNav();

    private Task SkipToContentAsync() => JS.InvokeVoidAsync("workplanSkip.toContent").AsTask();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    [Inject] private IJSRuntime JS { get; set; } = default!;
}
