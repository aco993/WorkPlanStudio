@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject DemoAuthenticationStateProvider Auth

@*
    Who you are working as. A native <details> element gives the menu keyboard
    support, Escape handling and an accessible expanded state for free; the
    persona list explains what each may do, so switching is also a tour of the
    permission model.
*@
<details class="persona" @ref="_details" @onkeydown="OnKeyDown">
    @*
        The accessible name is built from the content rather than imposed by a
        label attribute. It used to be the Persona_Title string alone, while the
        visible text was the persona itself - Planner, Supervisor or Guest. A
        name that does not contain the visible label is WCAG 2.5.3 Label in Name
        (level A): someone driving the page by voice says the word written on the
        control, and nothing matches it. Letting the name come from the content
        joins the two, so it both contains what the reader can see and still says
        what the control is for. The title stays the hover hint it always was.

        A newer axe-core reports this as label-content-name-mismatch, which is how
        it surfaced: the rule landed with a test-stack bump and turned 38 of the
        76 browser tests red at once, because this control is in the layout on
        every route.
    *@
    <summary class="persona-summary" title="@L["Persona_Title"]">
        <span class="sr-only">@L["Persona_Title"]</span>
        <span class="persona-avatar role-@Auth.CurrentRole.ToString().ToLowerInvariant()" aria-hidden="true">@Initial(Auth.CurrentRole)</span>
        <span class="persona-name">@L[$"Role_{Auth.CurrentRole}"]</span>
        <svg class="persona-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </summary>
    <div class="persona-panel" role="menu" aria-label="@L["Persona_Switch"]">
        <p class="persona-hint">@L["Persona_Hint"]</p>
        @foreach (var role in new[] { WorkspaceRole.Planner, WorkspaceRole.Supervisor, WorkspaceRole.Guest })
        {
            <button type="button" role="menuitemradio" aria-checked="@(role == Auth.CurrentRole ? "true" : "false")"
                    class="persona-option @(role == Auth.CurrentRole ? "active" : null)"
                    @onclick="() => SwitchAsync(role)">
                <span class="persona-avatar role-@role.ToString().ToLowerInvariant()" aria-hidden="true">@Initial(role)</span>
                <span class="persona-text">
                    <span class="persona-role">@L[$"Role_{role}"]</span>
                    <span class="persona-desc">@L[$"Role_{role}_Desc"]</span>
                </span>
            </button>
        }
    </div>
</details>

@code {
    private ElementReference _details;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnStateChanged;
        await Auth.GetAuthenticationStateAsync();   // loads the stored persona before CurrentRole is read
    }

    private string Initial(WorkspaceRole role) => L[$"Role_{role}"].Value[..1];

    private async Task SwitchAsync(WorkspaceRole role)
    {
        await Auth.SwitchAsync(role);
        await CloseAsync();
    }

    // <details> has no built-in Escape; closing it here keeps the menu keyboard-complete.
    private Task OnKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private Task CloseAsync() => JS.InvokeVoidAsync("workplanMenu.close", _details).AsTask();

    private void OnStateChanged(Task<AuthenticationState> task) => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.AuthenticationStateChanged -= OnStateChanged;

    [Inject] private IJSRuntime JS { get; set; } = default!;
}
