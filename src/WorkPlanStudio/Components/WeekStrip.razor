@using System.Globalization
@inject IStringLocalizer<SharedResource> L

@*
    One week of a working-time pattern as seven horizontal strips, one per
    weekday, coloured by segment kind. Pure rendering: the timeline is computed
    elsewhere, so this component has no state and no services beyond the
    localizer. Widths are percentages of a day, written invariant-culture.

    The strip used to be `role="img"` with the alt text "Weekly pattern". That role
    tells assistive technology to treat the whole subtree as one image and ignore
    everything inside it, so the alt text was the *name of the widget* and the seven
    days, every segment and every tooltip were thrown away — on the page the README
    calls the live preview of the week. The picture is now marked decorative and the
    same information is rendered as a table that only a screen reader reads.
*@
<div class="week-preview">
    <div class="week-strip" aria-hidden="true">
        @for (int day = 0; day < 7; day++)
        {
            var dayStart = day * DaySeconds;
            var pieces = Pieces(dayStart);
            <div class="week-row">
                <span class="week-day">@Culture.DateTimeFormat.GetAbbreviatedDayName(WeekdayOf(day))</span>
                <div class="week-track">
                    @foreach (var piece in pieces)
                    {
                        <span class="week-seg seg-@piece.Kind.ToString().ToLowerInvariant()"
                              style="left:@Pct(piece.StartSeconds - dayStart)%;width:@Pct(piece.DurationSeconds)%"
                              title="@Title(piece)"></span>
                    }
                </div>
            </div>
        }
        <div class="week-axis">
            <span></span>
            <div class="week-track">
                @for (int hour = 0; hour <= 24; hour += 6)
                {
                    <span class="week-tick" style="left:@Pct(hour * 3600L)%">@hour:00</span>
                }
            </div>
        </div>
    </div>

    @*
        The wrapper, not the table, carries `sr-only`. A table box grows to its
        min-content width whatever `width` says, and `overflow: hidden` on the table
        itself does not stop that — applied directly, this 1,550 px-wide table pushed
        the whole document into a horizontal scroll at a 640 px viewport. A div clips.
    *@
    <div class="sr-only">
        <table class="data-table week-table">
            <caption>@L["WorkingTime_Preview"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Ui_ColDay"]</th>
                    <th scope="col">@L["Ui_ColDetail"]</th>
                </tr>
            </thead>
            <tbody>
                @for (int day = 0; day < 7; day++)
                {
                    var weekday = WeekdayOf(day);
                    <tr @key="weekday">
                        <th scope="row">@Culture.DateTimeFormat.GetDayName(weekday)</th>
                        <td>@DayText(day * DaySeconds)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private const long DaySeconds = 24 * 3600;

    /// <summary>The timeline whose weekly pattern is drawn.</summary>
    [Parameter, EditorRequired] public WorkingTimeline Timeline { get; set; } = default!;

    private static CultureInfo Culture => CultureInfo.CurrentUICulture;

    /// <summary>The strip starts on Monday; <see cref="DayOfWeek"/> starts on Sunday.</summary>
    private static DayOfWeek WeekdayOf(int day) => (DayOfWeek)((day + 1) % 7);

    /// <summary>
    /// One day of the pattern in words — the same sentences the segments carry as
    /// tooltips, joined. A day with nothing on it says so rather than rendering empty,
    /// which would read as missing data instead of a closed day.
    /// </summary>
    private string DayText(long dayStart)
    {
        var text = string.Join("; ", Pieces(dayStart).Select(Title));
        return string.IsNullOrEmpty(text) ? L["Ui_WeekDayClosed"].Value : text;
    }

    private static string Pct(long seconds) =>
        (seconds * 100.0 / DaySeconds).ToString("0.###", CultureInfo.InvariantCulture);

    private IEnumerable<WeekWindow> Pieces(long dayStart)
    {
        long dayEnd = dayStart + DaySeconds;
        var all = Timeline.WeekWindows.Concat(Timeline.WeekGaps);
        foreach (var piece in all.OrderBy(p => p.StartSeconds))
        {
            if (piece.EndSeconds <= dayStart || piece.StartSeconds >= dayEnd)
                continue;
            yield return piece with
            {
                StartSeconds = Math.Max(piece.StartSeconds, dayStart),
                EndSeconds = Math.Min(piece.EndSeconds, dayEnd)
            };
        }

        // A continuous pattern has no windows at all: draw the whole day as work.
        if (Timeline.WeekWindows.Count == 0 && Timeline.Pattern.IsContinuous)
            yield return new WeekWindow(dayStart, dayEnd, SegmentKind.Working, "", DayOfWeek.Monday);
    }

    private string Title(WeekWindow piece)
    {
        var kind = L[$"Segment_{piece.Kind}"];
        var from = TimeSpan.FromSeconds(piece.StartSeconds % DaySeconds);
        var to = TimeSpan.FromSeconds(piece.EndSeconds % DaySeconds);
        var span = $"{from:hh\\:mm}–{(to == TimeSpan.Zero ? "24:00" : to.ToString(@"hh\:mm"))}";
        return string.IsNullOrEmpty(piece.Label) || piece.Kind == SegmentKind.Sunday
            ? $"{kind} · {span}"
            : $"{kind} · {L.ShiftName(piece.Label)} · {span}";
    }
}
