@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

@*
    Cycles the colour theme: system → light → dark → system. The effective theme
    is applied by app.js (so the first paint is right before Blazor loads); this
    button only changes the stored choice and reflects it.
*@
<button type="button" class="theme-toggle" @onclick="CycleAsync"
        aria-label="@Label" title="@Label" data-theme-mode="@_mode">
    @if (_mode == "dark")
    {
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
    }
    else if (_mode == "light")
    {
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" /></svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8m-4-4v4" /></svg>
    }
</button>

@code {
    private string _mode = "system";

    private string Label => string.Format(L["Theme_Toggle"], L[$"Theme_{_mode}"]);

    protected override async Task OnInitializedAsync() =>
        _mode = await JS.InvokeAsync<string>("workplanTheme.get");

    private async Task CycleAsync()
    {
        _mode = _mode switch { "system" => "light", "light" => "dark", _ => "system" };
        await JS.InvokeAsync<string>("workplanTheme.set", _mode);
    }
}
