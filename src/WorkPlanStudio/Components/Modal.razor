@implements IAsyncDisposable
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal-backdrop-custom" @onclick="OnBackdropAsync" @onkeydown="OnKeyDownAsync">
        <div @ref="_dialog"
             class="modal-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             tabindex="-1"
             @onclick:stopPropagation="true">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="modal-head">
                    <h3 id="@_titleId">@Title</h3>
                    <button type="button" class="icon-btn" aria-label="@L["Common_Close"]" @onclick="CloseAsync">✕</button>
                </div>
            }
            <div class="modal-body">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <div class="modal-foot">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private bool _wasVisible;

    /// <summary>
    /// Focus is handled on the *transition*, not on the close button's click, because
    /// ✕, Escape and the backdrop are the three least-used ways out of these dialogs.
    /// Every page closes its own dialog by assigning the bound field — Cancel does,
    /// and so does a successful Save — and those paths never reach
    /// <see cref="CloseAsync"/>. Watching Visible instead means focus returns to the
    /// control that opened the dialog however it was dismissed, including by the
    /// component being torn down on a navigation.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
            await JS.InvokeVoidAsync("workplanModal.open", _dialog);
        }
        else if (!Visible && _wasVisible)
        {
            _wasVisible = false;
            await JS.InvokeVoidAsync("workplanModal.close");
        }
    }

    /// <summary>Closes the dialog from outside — a page's own Cancel button, say.</summary>
    public Task CloseAsync()
    {
        Visible = false;
        return VisibleChanged.InvokeAsync(false);
    }

    private Task OnBackdropAsync() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    private Task OnKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    /// <summary>
    /// A dialog can also leave the page by being unmounted — a navigation while it is
    /// open. The trap listener and the stored return target would outlive it.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (!_wasVisible)
            return;
        _wasVisible = false;
        try
        {
            await JS.InvokeVoidAsync("workplanModal.close");
        }
        catch (JSDisconnectedException)
        {
            // the circuit is already gone; there is nothing left to restore focus to
        }
    }
}
