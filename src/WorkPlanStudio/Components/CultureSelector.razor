@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

@*
    The group needs a name of its own: "EN / DE" on its own tells a screen-reader
    user nothing about what the two buttons switch. `aria-pressed` says which one is
    on — the `active` class was carrying that alone.

    The language names stay in their own language (English, Deutsch), which is the
    convention for a language switch and the reason they are not resource strings.
*@
<div class="culture-selector" role="group" aria-label="@L["Ui_Language"]">
    @foreach (var option in _cultures)
    {
        <button type="button"
                class="culture-btn @(IsCurrent(option.Code) ? "active" : null)"
                lang="@option.Code"
                aria-pressed="@(IsCurrent(option.Code) ? "true" : "false")"
                title="@option.Name"
                @onclick="() => SetCulture(option.Code)">
            @option.Short
        </button>
    }
</div>

@code {
    private sealed record CultureOption(string Code, string Short, string Name);

    private readonly CultureOption[] _cultures =
    {
        new("en-US", "EN", "English"),
        new("de-DE", "DE", "Deutsch")
    };

    private static bool IsCurrent(string code) => CultureInfo.CurrentCulture.Name == code;

    /// <summary>
    /// Asks for the language in the address and reloads. Nothing is written here:
    /// the reload can be refused — the work-plan editor holds it while it asks
    /// about unsaved changes — and a preference written before the question is a
    /// preference the reader never agreed to. The page that really does start in
    /// the new language is the one that remembers it (see <c>js/app.js</c>).
    /// </summary>
    private void SetCulture(string code)
    {
        if (CultureInfo.CurrentCulture.Name == code)
            return;

        Nav.NavigateTo(AddressFor(code), forceLoad: true);
    }

    private string AddressFor(string code)
    {
        var address = new UriBuilder(Nav.Uri);
        var query = address.Query.TrimStart('?');
        var without = string.Join('&', query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Where(part => !part.StartsWith("culture=", StringComparison.Ordinal)));

        address.Query = string.IsNullOrEmpty(without) ? $"culture={code}" : $"{without}&culture={code}";
        return address.Uri.ToString();
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    /// <summary>
    /// The refused reload comes back as an ordinary navigation once the reader has
    /// answered — the editor sends them to the address it was holding, which still
    /// asks for the language. A soft navigation cannot deliver a language, so this
    /// turns it back into the reload it was.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var asked = AskedCulture(e.Location);
        if (asked is null || asked == CultureInfo.CurrentCulture.Name || _forced == e.Location)
            return;

        // Once per address. A forced load normally ends this component's life, but
        // "normally" is not an invariant: anything that swallows the reload would
        // otherwise see this handler answer its own navigation, for ever.
        _forced = e.Location;
        Nav.NavigateTo(e.Location, forceLoad: true);
    }

    private string? _forced;

    private static string? AskedCulture(string location)
    {
        var query = location.Split('?', 2).ElementAtOrDefault(1);
        return query?.Split('&')
            .FirstOrDefault(part => part.StartsWith("culture=", StringComparison.Ordinal))?["culture=".Length..];
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
