<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The optional server. The WebAssembly app is the product; this exists so the
    same product can be run with real accounts behind it when someone is willing
    to host something. Nothing in src/WorkPlanStudio depends on this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WorkPlanStudio.Api</RootNamespace>
    <UserSecretsId>workplanstudio-api</UserSecretsId>

    <!-- No XML documentation file. The libraries generate one because they are
         consumed as libraries; this is an application and its endpoint
         descriptions come from WithSummary(). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- No launch profile: the port is chosen with the urls switch or with
         ASPNETCORE_URLS, so nothing in the repository claims one. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Only the UI half of Swashbuckle: the document itself comes from the
         framework's own AddOpenApi(). The package ships its assets embedded, so
         the Development-only doc page pulls nothing from a CDN. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkPlanStudio.Contracts\WorkPlanStudio.Contracts.csproj" />
    <!-- Entities, validation rules, the policy table and the EF-to-engine
         mapping. The browser app references the same assembly, which is how the
         two hosts are kept from quietly disagreeing about what a valid work plan
         is. Persistence is deliberately not shared - see the project file. -->
    <ProjectReference Include="..\WorkPlanStudio.Domain\WorkPlanStudio.Domain.csproj" />
    <ProjectReference Include="..\WorkPlanStudio.Scheduling\WorkPlanStudio.Scheduling.csproj" />
    <ProjectReference Include="..\WorkPlanStudio.WorkingTime\WorkPlanStudio.WorkingTime.csproj" />
  </ItemGroup>

</Project>
