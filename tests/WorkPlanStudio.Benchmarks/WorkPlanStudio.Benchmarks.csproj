<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Micro-benchmarks for the two pure libraries with BenchmarkDotNet. Not a
    test project: run it explicitly (see docs/PERFORMANCE.md), or let the
    performance workflow run the short job and publish the results as an
    artifact. Numbers are only comparable on the same machine and runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WorkPlanStudio.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkPlanStudio.Scheduling\WorkPlanStudio.Scheduling.csproj" />
    <ProjectReference Include="..\..\src\WorkPlanStudio.WorkingTime\WorkPlanStudio.WorkingTime.csproj" />
  </ItemGroup>

</Project>
