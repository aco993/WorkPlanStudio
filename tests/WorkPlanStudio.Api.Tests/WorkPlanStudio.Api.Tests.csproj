<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests: the real application, hosted in-process by
    WebApplicationFactory, against a real SQLite file per test class. Nothing is
    stubbed — the authorization pipeline, the token handler, the migrations and
    the scheduling engine are the ones that ship. An in-memory provider would
    have hidden the very things worth testing here: unique indexes, check
    constraints and optimistic concurrency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WorkPlanStudio.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkPlanStudio.Api\WorkPlanStudio.Api.csproj" />
    <ProjectReference Include="..\..\src\WorkPlanStudio.Contracts\WorkPlanStudio.Contracts.csproj" />
  </ItemGroup>

</Project>
