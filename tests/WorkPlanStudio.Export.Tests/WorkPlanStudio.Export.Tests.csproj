<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the hand-written CSV, xlsx and PDF writers. They read the produced
    bytes back - unzipping the workbook and parsing the PDF cross-reference
    table - because "it did not throw" says nothing about whether Excel or a
    reader will accept the file. Pure .NET, no WebAssembly workload.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WorkPlanStudio.Export.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="WorkPlanStudio.Export" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkPlanStudio.Export\WorkPlanStudio.Export.csproj" />
  </ItemGroup>

</Project>
